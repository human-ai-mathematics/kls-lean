{
 "scope": "Codimension-m coarea program, step 2 (linear layer): the graph Jacobian in arbitrary codimension, and the exact agreement of the repository codimension-one graphJacobian with Mathlib normDet. NO area formula and NO coarea formula proved; no hole migrated. The log-concave Cheeger-Buser line belongs to collaborator Wang Haocheng and was not touched.",
 "head": "34b92695ece4f636a1a7f1eafbbf41c685ee0348",
 "origin_main": "34b92695ece4f636a1a7f1eafbbf41c685ee0348",
 "incoming_receipt": "build/verification/20260916T124243.885687Z/report.json",
 "incoming_snapshot": "a4ae471ae89cf4112376538ba0e54b7be6baaae2e3b96bfee329c87190998cc1",
 "incoming_entries": 514,
 "incoming_status": "passed",
 "finding": {
  "what": "the area formula already proved in Analysis/AreaFormula.lean is CODIMENSION ONE ONLY",
  "why": "its graph map is y -> iota y + g y . e with g REAL-VALUED; linear model graphLinear, factor graphJacobian a = sqrt(1 + norm a ^ 2)",
  "consequence": "reducing a general C1 parametrization to the existing graph formula only covers m = 1; a K-valued slope model had to be built first, which is what this round does"
 },
 "new_declarations": [
  "Analysis.graphMapLinear",
  "Analysis.graphMapLinear_apply",
  "Analysis.adjoint_comp_graphMapLinear",
  "Analysis.normDet_graphMapLinear_sq",
  "Analysis.normDet_graphMapLinear",
  "Analysis.normDet_graphLinear"
 ],
 "key_results": {
  "gram_operator": "the Gram operator of the graph map is 1 + adjoint A composed with A, on the PARAMETER space",
  "volume_factor": "sqrt(det(1 + adjoint A comp A)), a determinant on the parameter space, independent of the ambient embedding",
  "squared_form": "needs no square root and no positivity argument",
  "codimension_one_agreement": "normDet (graphLinear iota e a) = graphJacobian a, proved by uniqueness of the linear volume factor (some set has positive finite measure) rather than by a rank-one determinant lemma; this identifies the repository framework with Mathlib normDet"
 },
 "local_import_closure_of_new_module": [
  "FunctionalInequalities.Analysis.AreaFormula",
  "FunctionalInequalities.Analysis.CoareaJacobian",
  "FunctionalInequalities.Analysis.GraphJacobian",
  "FunctionalInequalities.Analysis.LevelSet",
  "FunctionalInequalities.KLS.Geometry.SurfaceMeasure",
  "FunctionalInequalities.Probability.Line.BrunnMinkowski"
 ],
