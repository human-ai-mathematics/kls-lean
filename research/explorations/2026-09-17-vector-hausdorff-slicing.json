 "new_declarations": [
  "Analysis.exists_measurable_majorant_of_eqOn_vector",
  "Analysis.exists_cover_cost_lt_vector",
  "Analysis.exists_levelBall",
  "Analysis.exists_measurable_majorant_vector",
