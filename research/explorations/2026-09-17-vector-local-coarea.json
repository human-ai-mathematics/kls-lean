 "weighted_area_formula": {
  "what": "the surface integral of an arbitrary measurable ENNReal weight over a piece of a C1 graph is the Lebesgue integral of that weight against the graph area density",
  "how": "map_vectorGraphMap_withDensity upgrades B2 from an identity of measures of SETS to an identity of MEASURES: the graph parametrization pushes the Jacobian-weighted Lebesgue measure forward to the normalized surface measure restricted to the graph; injectivity of the graph map is automatic by construction and its image is measurable, both already proved",
  "B2_is_the_weight_one_case": "recovered verbatim in the audit as unweighted_is_B2",
  "hypotheses": "the parameter set need only be measurable; no integrability, finiteness or boundedness, and the weight may be identically infinite"
 },
 "local_coarea": {
  "inputs": [
   "ambient side setLIntegral_coareaJacobian_levelGraphFamily (previous round)",
   "fibre side setLIntegral_image_vectorGraphMap (this round)",
   "slice description slice_eq_image_vectorGraphMap (charting round)"
  ],
  "glue": "Tonelli in the level variable",
  "results": [
   "setLIntegral_coarea_levelGraphFamily, the codimension-m analogue of the scalar setLIntegral_coarea_graph_family",
   "exists_vector_coarea_neighborhood: every point where the differential is surjective has an open neighbourhood on every Borel subset of which the coarea equality holds for every measurable ENNReal weight, with the surface measure in dimension finrank V - finrank W"
  ],
  "hypotheses": "u is C1 on an open set and its differential is surjective at the point; no regularity outside that open set, and no finiteness, boundedness, integrability, regular-value or SFinite hypothesis"
 },
 "scalar_consistency": {
  "codimension_one_graphArea": "the repository's proved Analysis.setLIntegral_image_graphMap is recovered from the codimension-m weighted formula",
  "codimension_one_coarea_density": "the ambient density of the local coarea equality is the gradient norm when m = 1, through the proved coareaJacobian_fderiv"
 },
 "is_not": [
  "NOT the codimension-m regular coarea formula",
  "missing: codimension-m WEIGHTED SLICE MEASURABILITY, the AEMeasurable statement for t |-> the inner integral, without which a sum cannot be exchanged with the outer integral (lintegral_tsum needs measurability); scalar analogue KLS/Geometry/OpenSliceMeasurable.lean",
  "missing: the countable cover with disjoint patching assembling the neighbourhood form into an equality on a whole regular open set; scalar analogue the assembly in KLS/Geometry/RegularCoarea.lean",
  "nothing about the critical set, sharp finite-regularity Sard, the two Cheeger comparisons or the five Energy holes"
 ],
