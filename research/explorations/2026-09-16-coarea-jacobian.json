{
 "scope": "Linear-algebra layer of the codimension-m coarea program: Analysis.coareaJacobian and its basic theory. NO coarea formula proved; no hole migrated. The log-concave Cheeger-Buser line belongs to collaborator Wang Haocheng and was not touched.",
 "head": "34b92695ece4f636a1a7f1eafbbf41c685ee0348",
 "origin_main": "34b92695ece4f636a1a7f1eafbbf41c685ee0348",
 "head_note": "HEAD is no longer dcc158d: a concurrent session committed 34b9269 \"docs: add KLS literature map through July 2026\" (documentation only, not pushed). This round did not touch it.",
 "incoming_receipt": "build/verification/20260916T120611.840573Z/report.json",
 "incoming_snapshot": "edbda70a4b2d1c0fa48ceabdaa0a88c1d5daa66cc6dcff34e9e14a017aff9762",
 "incoming_entries": 506,
 "incoming_status": "passed",
 "new_definition": "FunctionalInequalities.Analysis.coareaJacobian",
 "definition": "coareaJacobian (L : V →L[ℝ] W) = LinearMap.normDet (LinearMap.adjoint (L : V →ₗ[ℝ] W)), i.e. sqrt (det (L comp adjoint L))",
 "mathlib_reuse": {
  "module": "Mathlib/Analysis/InnerProductSpace/NormDet.lean",
  "reused": [
   "LinearMap.normDet",
   "LinearMap.normDet_nonneg",
   "LinearMap.normDet_sq",
   "LinearMap.normDet_eq_zero_iff_ker_ne_bot",
   "LinearMap.normDet_of_subsingleton"
  ],
  "note": "normDet is the AREA-formula Jacobian sqrt(det(f^T f)) for maps out of a finite-dimensional space; the coarea Jacobian is its adjoint counterpart. Determinant theory was not re-derived. Mathlib also already proves LinearMap.hausdorffMeasure_image, that normDet is the Hausdorff volume factor; that theorem is available for later rounds but is not used here."
 },
 "new_lemmas": [
  "coareaJacobian_nonneg",
  "coareaJacobian_sq",
  "adjoint_one",
  "coareaJacobian_eq_norm_toDual_symm",
  "coareaJacobian_fderiv",
  "ker_adjoint",
  "coareaJacobian_eq_zero_iff",
  "coareaJacobian_ne_zero_iff"
 ],
 "key_compatibility": {
  "lemma": "coareaJacobian_fderiv",
  "statement": "coareaJacobian (fderiv R u x) = norm (gradient u x)",
  "meaning": "the proved and audited scalar coarea theory L11/L12/L13 is literally the m = 1 case of this density; no existing statement is restated, weakened or rewritten",
  "proved_not_asserted": true
 },
 "regular_set": "coareaJacobian L != 0 iff the differential is surjective; for W = R this degenerates to a nonzero gradient",
 "local_import_closure_of_new_module": [
  "FunctionalInequalities.Analysis.CoareaJacobian"
 ],
