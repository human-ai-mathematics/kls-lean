 "route_taken_differs_from_the_scalar_one": {
  "scalar": "KLS/Geometry/OpenSliceMeasurable.lean proves slice measurability for an ARBITRARY Borel subset of an open C1 domain with NO regular-point hypothesis, through the Eilenberg slicing inequality of KLS/Geometry/SurfaceSlicing.lean",
  "obstacle": "the codimension-m Eilenberg inequality is NOT proved in this repository and Mathlib does not provide it",
  "what_was_done_instead": "go through the chart: on a level-graph family the slice integral is the Tonelli section of one measurable function on the parameter-level product, so measurability is immediate and no slicing inequality is used",
  "cost": "the slice measurability proved here holds only where the differential is surjective; it does NOT cover the critical set"
 },
 "new_declarations": [
  "Analysis.measurable_setLIntegral_inter_levelSet_levelGraphFamily",
  "Analysis.exists_vector_coarea_neighborhood_measurable",
  "Analysis.coarea_of_contDiffOn_of_coareaJacobian_ne_zero"
 ],
 "main_result": {
  "name": "Analysis.coarea_of_contDiffOn_of_coareaJacobian_ne_zero",
  "statement": "on an open set where the differential of u is everywhere surjective, for every Borel S inside it and every measurable ENNReal weight, the level function is MEASURABLE and the integral of the ambient coarea density against the weight equals the level integral of the surface integrals over the fibres, with fibre measure the normalized Hausdorff measure in dimension finrank V minus finrank W",
  "analogue_of": "the scalar L9, KLS.coarea_of_contDiffOn_of_fderiv_ne_zero",
  "stronger_than_the_scalar_in_one_respect": "the level function is Measurable, not merely AEMeasurable; this is a by-product of the chart route",
  "assembly": "countable cover, disjointed pieces, the neighbourhood form on each piece, lintegral_tsum to exchange the sum with the outer integral - the same shape as the scalar assembly",
  "hypotheses": "u is C1 on an open set and its differential is surjective at every point of it; no finiteness, boundedness, integrability, regular-value or SFinite hypothesis, and no regularity outside that set"
 },
 "scalar_consistency": {
  "scalar_L9": "the audit reproduces the statement of the proved KLS.coarea_of_contDiffOn_of_fderiv_ne_zero VERBATIM - gradient norm, surfaceMeasure V, AEMeasurable - and discharges it from the codimension-m theorem",
  "bridges": [
   "coareaJacobian_fderiv: the ambient density is the gradient norm",
   "finrank V minus finrank R equals finrank V minus 1, so the fibre measure is surfaceMeasure V",
   "coareaJacobian_ne_zero_of_fderiv_ne_zero: a nonzero real differential is surjective"
  ]
 },
 "is_not": [
  "NOT the general codimension-m coarea formula (the analogue of L11 to L13); that needs the CRITICAL SET, hence a codimension-m Sard or critical-slice argument, neither of which is proved",
  "NOT slice measurability without the regularity hypothesis; the codimension-m Eilenberg slicing inequality is not proved",
  "nothing about sharp finite-regularity Sard, the two Cheeger comparisons or the five Energy holes"
 ],
