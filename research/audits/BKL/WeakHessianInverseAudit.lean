  have hW1 : ContDiff ℝ 1 W := hW.of_le (WithTop.coe_le_coe.mpr le_top)
  exact integral_mul_generator_eq_neg_energy_of_contDiff_one hC1 hG hW1 hF hdet
    hC1 hG hη hηc

