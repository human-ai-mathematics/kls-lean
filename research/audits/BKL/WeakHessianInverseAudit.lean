      ((volume : Measure (EuclideanSpace ℝ (Fin n))).tilted (-u)).map (gradient u) =
        (μ : Measure (EuclideanSpace ℝ (Fin n))) ∧
      ContDiff ℝ 1 u ∧ LipschitzWith (Real.toNNReal (16 / κ)) (gradient u) ∧
      LipschitzWith LF (fun x => -u x + W (gradient u x)) ∧
      (∀ x h, u (x + h) + u (x - h) - 2 * u x ≤ (4 / κ) * ‖h‖ ^ 2) ∧
      (∀ᵐ x ∂(volume : Measure (EuclideanSpace ℝ (Fin n))),
        (hessianMatrix u x).PosDef ∧
        Real.log (hessianMatrix u x).det = -u x + W (gradient u x) ∧
        ((16 / κ) • (1 : Matrix (Fin n) (Fin n) ℝ) - hessianMatrix u x).PosSemidef) ∧
      (∀ k i j,
        HasWeakDerivAlong (fun x => hessianMatrix u x i j) (fun x => T x k i j)
            (EuclideanSpace.basisFun (Fin n) ℝ k) ∧
          ∀ S : Set (EuclideanSpace ℝ (Fin n)), IsCompact S →
            MemLp (fun x => T x k i j) 2 ((volume : Measure (EuclideanSpace ℝ (Fin n))).restrict S)) ∧
      (∃ LE : NNReal,
        LipschitzWith LE (fun x => Real.exp (-u x + W (gradient u x)))) ∧
      (∀ k : Fin n,
        HasWeakDerivAlong (fun x => (hessianMatrix u x).det)
          (fun x => (hessianMatrix u x).det *
            ((hessianMatrix u x)⁻¹ * (Matrix.of fun i j => T x k i j)).trace)
          (EuclideanSpace.basisFun (Fin n) ℝ k) ∧
        (∀ S : Set (EuclideanSpace ℝ (Fin n)), IsCompact S →
          MemLp (fun x => (hessianMatrix u x).det *
            ((hessianMatrix u x)⁻¹ * (Matrix.of fun i j => T x k i j)).trace)
            2 ((volume : Measure (EuclideanSpace ℝ (Fin n))).restrict S)) ∧
        HasWeakDerivAlong (fun x => Real.log (hessianMatrix u x).det)
          (fun x => ((hessianMatrix u x)⁻¹ * (Matrix.of fun i j => T x k i j)).trace)
          (EuclideanSpace.basisFun (Fin n) ℝ k) ∧
        (∀ᵐ x ∂(volume : Measure (EuclideanSpace ℝ (Fin n))),
          ((hessianMatrix u x)⁻¹ * (Matrix.of fun i j => T x k i j)).trace =
            fderiv ℝ (fun y => -u y + W (gradient u y)) x
              (EuclideanSpace.basisFun (Fin n) ℝ k)) ∧
        (∀ᵐ x ∂(volume : Measure (EuclideanSpace ℝ (Fin n))),
          ((hessianMatrix u x)⁻¹ * (Matrix.of fun i j => T x k i j)).trace =
            -fderiv ℝ u x (EuclideanSpace.basisFun (Fin n) ℝ k) +
              ∑ a : Fin n, hessianMatrix u x k a *
                fderiv ℝ W (gradient u x) (EuclideanSpace.basisFun (Fin n) ℝ a))) ∧
      (∀ k i j : Fin n,
        HasWeakDerivAlong (fun x => (hessianMatrix u x)⁻¹ i j)
          (fun x => -(((hessianMatrix u x)⁻¹ *
            (Matrix.of fun a b => T x k a b) * (hessianMatrix u x)⁻¹) i j))
          (EuclideanSpace.basisFun (Fin n) ℝ k) ∧
        (∀ S : Set (EuclideanSpace ℝ (Fin n)), IsCompact S →
          MemLp (fun x => -(((hessianMatrix u x)⁻¹ *
            (Matrix.of fun a b => T x k a b) * (hessianMatrix u x)⁻¹) i j)) 2
            ((volume : Measure (EuclideanSpace ℝ (Fin n))).restrict S)) ∧
        ∀ S : Set (EuclideanSpace ℝ (Fin n)), IsCompact S →
          MemLp (fun x => (hessianMatrix u x)⁻¹ i j) (⊤ : ENNReal)
            ((volume : Measure (EuclideanSpace ℝ (Fin n))).restrict S)) ∧
      ∀ (i b a j : Fin n) (ψ : EuclideanSpace ℝ (Fin n) → ℝ),
        ContDiff ℝ 1 ψ → HasCompactSupport ψ →
        (∫ x, T x j i b *
          (ψ x * (-(((hessianMatrix u x)⁻¹ *
            (Matrix.of fun c d => T x a c d) * (hessianMatrix u x)⁻¹) a b)) +
            fderiv ℝ ψ x (EuclideanSpace.basisFun (Fin n) ℝ a) *
              (hessianMatrix u x)⁻¹ a b)
          ∂(volume : Measure (EuclideanSpace ℝ (Fin n)))) =
        ∫ x, T x a i b *
          (ψ x * (-(((hessianMatrix u x)⁻¹ *
            (Matrix.of fun c d => T x j c d) * (hessianMatrix u x)⁻¹) a b)) +
            fderiv ℝ ψ x (EuclideanSpace.basisFun (Fin n) ℝ j) *
              (hessianMatrix u x)⁻¹ a b)
          ∂(volume : Measure (EuclideanSpace ℝ (Fin n))) := by
  obtain ⟨u, L, LF, T, hc, hl, hnrm, hm, hC1, hG, hF, hw, hd, hT, he, hfirst, hInv⟩ :=
    exists_regular_moment_weak_inverse hn hκ hK hKc hKint hW hstrong μ hμ hiso
  refine ⟨u, L, LF, T, hc, hl, hnrm, hm, hC1, hG, hF, hw, hd, hT, he, hfirst, hInv, ?_⟩
  intro i b a j ψ hψ hψc
  let e : Fin n → EuclideanSpace ℝ (Fin n) := EuclideanSpace.basisFun (Fin n) ℝ
  let H := hessianMatrix u
  let R : EuclideanSpace ℝ (Fin n) → Matrix (Fin n) (Fin n) ℝ := fun x => (H x)⁻¹
  let D : Fin n → EuclideanSpace ℝ (Fin n) → ℝ :=
    fun k x => -((R x * (Matrix.of fun c d => T x k c d) * R x) a b)
  let η : EuclideanSpace ℝ (Fin n) → ℝ := fun x => ψ x * R x a b
  let dη : Fin n → EuclideanSpace ℝ (Fin n) → ℝ :=
    fun k x => ψ x * D k x + fderiv ℝ ψ x (e k) * R x a b
  have hweak (k : Fin n) : HasWeakDerivAlong η (dη k) (e k) := by
    exact (hInv k a b).1.mul_contDiff hψ hψc
  have hηc : HasCompactSupport η := hψc.mul_right
  have hψd (k : Fin n) : Continuous (fun x => fderiv ℝ ψ x (e k)) :=
    (hψ.continuous_fderiv (by simp)).clm_apply continuous_const
  have hψdc (k : Fin n) : HasCompactSupport (fun x => fderiv ℝ ψ x (e k)) := by
    change HasCompactSupport ((fun A : EuclideanSpace ℝ (Fin n) →L[ℝ] ℝ => A (e k)) ∘
      fderiv ℝ ψ)
    exact (hψc.fderiv ℝ).comp_left (by simp)
  have hdηc (k : Fin n) : HasCompactSupport (dη k) := by
    exact hψc.mul_right.add (hψdc k).mul_right
  have hR2 (S : Set (EuclideanSpace ℝ (Fin n))) (hS : IsCompact S) :
      MemLp (fun x => R x a b) 2
        ((volume : Measure (EuclideanSpace ℝ (Fin n))).restrict S) := by
    let : IsFiniteMeasure ((volume : Measure (EuclideanSpace ℝ (Fin n))).restrict S) :=
      isFiniteMeasure_restrict.mpr hS.measure_lt_top.ne
    exact ((hInv j a b).2.2 S hS).mono_exponent le_top
  have hdη2 (k : Fin n) : MemLp (dη k) 2
      (volume : Measure (EuclideanSpace ℝ (Fin n))) := by
    exact (client_cutoff_memLp hψ.continuous hψc (hInv k a b).2.1).add
      (client_cutoff_memLp (hψd k) (hψdc k) hR2)
  exact integral_weakDeriv_mul_eq_swap (hT j i b).1 (hT a i b).1
    (hT j i b).2 (hT a i b).2 (hweak j) (hweak a) hηc (hdηc j) (hdηc a)
    (hdη2 j) (hdη2 a)

