module

public import FunctionalInequalities.Analysis.LogRadial.Operator
public import examples.EllipticDrift

/-!
# Client of the small-radius drift margin

`skew_drift_margin_client`: for `ℓ = Λ = 1`, `ε = 1/24`, `B = 2`, the radius `ρ` generated by the
main theorem is
chosen once. From it the client builds the actual point `x = (t, t)` with `t = ρ / (2 √2) > 0` in
ambient `ℝ²`
(`m = 0`), the unit tangent `ζ = e₀`, the shift `β = 0` (so `r = ρ / 2 < ρ`), the nonzero drift `b =
(1, -1)`
(`‖b‖ = √2 ≤ 2`), and the skew coefficient `[[1, k], [-k, 1]]` of the audit fixture for an ARBITRARY
`k`. Applying the main theorem gives the margin `1 / (4 ρ)`.
-/

@[expose] public section

noncomputable section
open scoped ContDiff

namespace FunctionalInequalities.Analysis.LogRadialDriftClient

open FunctionalInequalities.Analysis

theorem skew_drift_margin_client (k : ℝ) :
    ∃ ρ : ℝ,
      0 < ρ ∧
        ρ < 1 ∧
          let zeta : EuclideanSpace ℝ (Fin 2) := WithLp.toLp 2 ![1, 0]
          let x : EuclideanSpace ℝ (Fin 2) :=
            WithLp.toLp 2 ![ρ / (2 * Real.sqrt 2), ρ / (2 * Real.sqrt 2)]
          let b : EuclideanSpace ℝ (Fin 2) := WithLp.toLp 2 ![1, -1]
          let φ : EuclideanSpace ℝ (Fin 2) → ℝ := fun y =>
            (Real.sqrt (((∑ i, zeta i * y i) - 0) ^ 2 + (y 1) ^ 2) + ((∑ i, zeta i * y i) - 0) -
                1 / 24 * y 1 * Real.log (((∑ i, zeta i * y i) - 0) ^ 2 + (y 1) ^ 2)) /
              2
          b ≠ 0 ∧
            1 / (4 * ρ) ≤
              Matrix.trace
                  (CNSCoefficientScopeAudit.coefficient k *
                    ((Matrix.of fun i j =>
                        fderiv ℝ (fderiv ℝ φ) x (EuclideanSpace.single i (1 : ℝ))
                          (EuclideanSpace.single j (1 : ℝ))) :
                      Matrix (Fin 2) (Fin 2) ℝ)) +
                (fderiv ℝ φ x) b := by
  -- the radius is generated ONCE by the main theorem

  obtain ⟨ρ, hρ0, hρ1, hmain⟩ :=
    exists_log_radial_drift_margin_radius (ell := 1) (Λ := 1) (ε := 1 / 24) (B := 2) one_pos
      one_pos (by norm_num) (by norm_num) (by norm_num)
  refine ⟨ρ, hρ0, hρ1, ?_⟩
  intro zeta x b
    φ
      -- the generated point geometry from the shared client-only fixture

  have hfix := LogRadialDriftPointFixture.drift_point_geometry hρ0 k
  have hz : ‖zeta‖ = 1 := hfix.1
  have hztan : zeta (Fin.last 1) = 0 := hfix.2.1
  have hb0 : b ≠ 0 := hfix.2.2.1
  have hb : ‖b‖ ≤ 2 := hfix.2.2.2.1
  have hx : 0 < x (Fin.last 1) := hfix.2.2.2.2.1
  have hsq : Real.sqrt (((∑ i, zeta i * x i) - 0) ^ 2 + (x (Fin.last 1)) ^ 2) = ρ / 2 :=
    hfix.2.2.2.2.2.2.1
  have hell :
    ∀ v : EuclideanSpace ℝ (Fin 2),
      1 * ‖v‖ ^ 2 ≤ (∑ i, ∑ j, CNSCoefficientScopeAudit.coefficient k i j * v i * v j) ∧
        (∑ i, ∑ j, CNSCoefficientScopeAudit.coefficient k i j * v i * v j) ≤ 1 * ‖v‖ ^ 2 :=
    hfix.2.2.2.2.2.2.2
  have hr : Real.sqrt (((∑ i, zeta i * x i) - 0) ^ 2 + (x (Fin.last 1)) ^ 2) < ρ := by
    rw [hsq]
    linarith
  have h :
    1 / (8 * Real.sqrt (((∑ i, zeta i * x i) - 0) ^ 2 + (x (Fin.last 1)) ^ 2)) ≤
      Matrix.trace
          (CNSCoefficientScopeAudit.coefficient k *
            ((Matrix.of fun i j =>
                fderiv ℝ (fderiv ℝ φ) x (EuclideanSpace.single i (1 : ℝ))
                  (EuclideanSpace.single j (1 : ℝ))) :
              Matrix (Fin 2) (Fin 2) ℝ)) +
        (fderiv ℝ φ x) b :=
    hmain 0 zeta hz hztan (CNSCoefficientScopeAudit.coefficient k) hell b hb 0 x hx hr
  rw [hsq] at h
  refine ⟨hb0, le_of_eq_of_le ?_ h⟩
  field_simp
  ring

end FunctionalInequalities.Analysis.LogRadialDriftClient

#print axioms FunctionalInequalities.Analysis.LogRadialDriftClient.skew_drift_margin_client
