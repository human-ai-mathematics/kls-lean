module

public import Mathlib.Analysis.InnerProductSpace.Calculus
public import Mathlib.Analysis.Calculus.FDeriv.Symmetric
public import Mathlib.Analysis.Calculus.ContDiff.FTaylorSeries
public import Mathlib.Analysis.Calculus.BumpFunction.Normed
public import Mathlib.Analysis.Calculus.BumpFunction.InnerProduct

/-!
# Iterated derivatives: a Leibniz rule and symmetry

Two pointwise facts about higher Fréchet derivatives used by the tilt calculus of
Bizeul–Klartag–Lehec (arXiv:2610.05474v1, Lemma 3.6):

* the Leibniz rule with a linear factor,
  `∇^{d+1}⟪w, G w⟫(z)(h) = ⟪z, ∇^{d+1}G(z)(h)⟫ + ∑_k ⟪h_k, ∇^d G(z)(h without h_k)⟫`;
* the chain rule along a continuous linear map for a map that is `Cⁿ` on an open set,
  `∇ⁿ(g ∘ L)(x) = ∇ⁿg(Lx) ∘ (L, …, L)`;
* symmetry of the iterated derivatives of a `C^∞` map from a real inner product space to a real
  normed space,
  `∇ⁿf(x)(v ∘ σ) = ∇ⁿf(x)(v)`. Mathlib's `ContDiffAt.iteratedFDeriv_comp_perm` requires
  analyticity; here the symmetric group is generated by the stabilizer of the first index and the
  transposition of the first two, the latter handled by Schwarz's theorem; and its local version
  for maps that are `C^∞` on an open set, by a smooth cutoff.
-/

@[expose] public section

noncomputable section

open scoped RealInnerProductSpace ContDiff

namespace FunctionalInequalities.Analysis.BakryEmery

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

private theorem eval_deriv {G : E → E} (hG : ContDiff ℝ ∞ G)
    (n : ℕ) (v : Fin n → E) (z : E) :
    HasFDerivAt (fun w => iteratedFDeriv ℝ n G w v)
      ((ContinuousMultilinearMap.apply ℝ (fun _ : Fin n => E) E v).comp
        (fderiv ℝ (iteratedFDeriv ℝ n G) z)) z := by
  exact
    (ContinuousMultilinearMap.apply ℝ (fun _ : Fin n => E) E v).hasFDerivAt.comp z
      (hG.differentiable_iteratedFDeriv
        (m := n) (by exact_mod_cast ENat.natCast_lt_top n)).differentiableAt.hasFDerivAt

/-- Leibniz rule with a linear factor: for smooth `G : E → E`,
`∇^{d+1}⟪w, G w⟫(z)(h) = ⟪z, ∇^{d+1}G(z)(h)⟫ + ∑_k ⟪h_k, ∇^d G(z)(h without h_k)⟫`. -/
theorem iteratedFDeriv_inner_self_apply {G : E → E} (hG : ContDiff ℝ ∞ G) (d : ℕ) (z : E)
    (h : Fin (d + 1) → E) :
    iteratedFDeriv ℝ (d + 1) (fun w => ⟪w, G w⟫) z h =
      ⟪z, iteratedFDeriv ℝ (d + 1) G z h⟫ +
        ∑ k : Fin (d + 1), ⟪h k, iteratedFDeriv ℝ d G z (k.removeNth h)⟫ := by
  classical
  induction d generalizing z with
  | zero =>
      rw [iteratedFDeriv_one_apply]
      have hd :=
        (hasFDerivAt_id z).inner ℝ
          (hG.differentiable (by simp)).differentiableAt.hasFDerivAt
      simp only [id_eq] at hd
      rw [hd.fderiv]
      simp [fderivInnerCLM_apply, iteratedFDeriv_one_apply,
        iteratedFDeriv_zero_apply]
  | succ d IH =>
      have hEq :
          (fun w =>
            iteratedFDeriv ℝ (d + 1) (fun y => ⟪y, G y⟫) w (Fin.tail h)) =
          (fun w =>
            ⟪w, iteratedFDeriv ℝ (d + 1) G w (Fin.tail h)⟫ +
              ∑ k : Fin (d + 1),
                ⟪Fin.tail h k,
                  iteratedFDeriv ℝ d G w (k.removeNth (Fin.tail h))⟫) :=
        funext fun w => IH w (Fin.tail h)
      have hmain :=
        (hasFDerivAt_id z).inner ℝ
          (eval_deriv hG (d + 1) (Fin.tail h) z)
      have hsum :=
        HasFDerivAt.fun_sum (u := Finset.univ) (fun k _ =>
          (hasFDerivAt_const (Fin.tail h k) z).inner ℝ
            (eval_deriv hG d (k.removeNth (Fin.tail h)) z))
      have hF : DifferentiableAt ℝ
          (iteratedFDeriv ℝ (d + 1) (fun y => ⟪y, G y⟫)) z :=
        (contDiff_id.inner ℝ hG).differentiable_iteratedFDeriv
          (by exact_mod_cast ENat.natCast_lt_top (d + 1)) z
      simp only [id_eq] at hmain
      rw [hF.iteratedFDeriv_succ_apply_left', hEq,
        (hmain.fun_add hsum).fderiv]
      simp only [add_apply, ContinuousLinearMap.comp_apply,
        ContinuousLinearMap.prod_apply, ContinuousLinearMap.id_apply,
        zero_apply, fderivInnerCLM_apply,
        ContinuousMultilinearMap.apply_apply, inner_zero_left, add_zero,
        sum_apply]
      have hcons : Fin.cons (h 0) (Fin.tail h) = h :=
        Fin.cons_self_tail h
      have hremove (k : Fin (d + 1)) :
          Fin.cons (h 0) (k.removeNth (Fin.tail h)) =
            k.succ.removeNth h := by
        rw [← hcons]
        exact
          (Fin.cons_comp_succ_succAbove (h 0) (Fin.tail h) k).symm
      change
        (⟪z, iteratedFDeriv ℝ (d + 1 + 1) G z h⟫ +
          ⟪h 0, iteratedFDeriv ℝ (d + 1) G z (Fin.tail h)⟫) +
          ∑ k : Fin (d + 1),
            ⟪Fin.tail h k,
              fderiv ℝ (iteratedFDeriv ℝ d G) z (h 0)
                (k.removeNth (Fin.tail h))⟫ = _
      conv_rhs => rw [Fin.sum_univ_succ]
      simp only [Fin.removeNth_zero, Fin.tail_def]
      rw [add_assoc]
      congr 1
      congr 1
      apply Finset.sum_congr rfl
      intro k _
      have hh :=
        iteratedFDeriv_succ_apply_left
          (𝕜 := ℝ) (f := G) (x := z)
          (Fin.cons (h 0) (k.removeNth (Fin.tail h)))
      simp only [Fin.cons_zero, Fin.tail_cons] at hh
      rw [hremove k] at hh
      exact congrArg (inner ℝ (h k.succ)) hh.symm

section Symmetry

variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]

/-- If `∇ⁿf` is symmetric at every point, `∇ⁿ⁺¹f(x)` is invariant under permutations fixing the
first (differentiation) index. -/
theorem iteratedFDeriv_succ_comp_perm_of_fix_zero {f : E → F} (hf : ContDiff ℝ ∞ f) {n : ℕ}
    (ih : ∀ (y : E) (w : Fin n → E) (τ : Equiv.Perm (Fin n)),
      iteratedFDeriv ℝ n f y (w ∘ τ) = iteratedFDeriv ℝ n f y w)
    (x : E) (v : Fin (n + 1) → E) (σ : Equiv.Perm (Fin (n + 1))) (hσ : σ 0 = 0) :
    iteratedFDeriv ℝ (n + 1) f x (v ∘ σ) = iteratedFDeriv ℝ (n + 1) f x v := by
    have hne : ∀ i : Fin n, σ i.succ ≠ 0 := by
      intro i hi
      have hs : σ i.succ = σ 0 := by
        rw [hi, hσ]
      exact Fin.succ_ne_zero i (σ.injective hs)

    let p : Fin n → Fin n := fun i => Fin.pred (σ i.succ) (hne i)

    have hp : Function.Injective p := by
      intro i j hij
      apply Fin.succ_injective
      have hs : (p i).succ = (p j).succ := congrArg Fin.succ hij
      simpa [p] using hs

    have hp' : Function.Surjective p :=
      (Finite.injective_iff_surjective).mp hp

    let τ : Equiv.Perm (Fin n) :=
      Equiv.ofBijective p ⟨hp, hp'⟩

    have hτ : ∀ i : Fin n, (τ i).succ = σ i.succ := by
      intro i
      change (p i).succ = σ i.succ
      simp [p]

    have htail : Fin.tail (v ∘ σ) = (Fin.tail v) ∘ τ := by
      funext i
      simp only [Function.comp_apply, Fin.tail]
      rw [hτ i]

    have hdiff : Differentiable ℝ (iteratedFDeriv ℝ n f) :=
      ContDiff.differentiable_iteratedFDeriv
        (by exact_mod_cast ENat.natCast_lt_top n) hf

    have hfun :
        (fun y => iteratedFDeriv ℝ n f y ((Fin.tail v) ∘ τ)) =
          (fun y => iteratedFDeriv ℝ n f y (Fin.tail v)) := by
      funext y
      exact ih y (Fin.tail v) τ

    calc
      iteratedFDeriv ℝ (n + 1) f x (v ∘ σ) =
          fderiv ℝ (iteratedFDeriv ℝ n f) x
            ((v ∘ σ) 0) (Fin.tail (v ∘ σ)) := by
        rw [iteratedFDeriv_succ_apply_left]
      _ = fderiv ℝ (iteratedFDeriv ℝ n f) x
            (v 0) ((Fin.tail v) ∘ τ) := by
        simp only [Function.comp_apply, hσ]
        rw [htail]
      _ = fderiv ℝ
            (fun y => iteratedFDeriv ℝ n f y ((Fin.tail v) ∘ τ)) x (v 0) := by
        exact
          (fderiv_continuousMultilinear_apply_const_apply
            (hdiff x) ((Fin.tail v) ∘ τ) (v 0)).symm
      _ = fderiv ℝ
            (fun y => iteratedFDeriv ℝ n f y (Fin.tail v)) x (v 0) := by
        rw [hfun]
      _ = fderiv ℝ (iteratedFDeriv ℝ n f) x (v 0) (Fin.tail v) := by
        exact
          fderiv_continuousMultilinear_apply_const_apply
            (hdiff x) (Fin.tail v) (v 0)
      _ = iteratedFDeriv ℝ (n + 1) f x v := by
        rw [iteratedFDeriv_succ_apply_left]

private theorem iteratedFDeriv_add_two_apply_left {f : E → F}
    (hf : ContDiff ℝ ∞ f) (n : ℕ) (x : E) (v : Fin (n + 2) → E) :
    iteratedFDeriv ℝ (n + 2) f x v =
      fderiv ℝ (fderiv ℝ (fun y => iteratedFDeriv ℝ n f y (Fin.tail (Fin.tail v))))
        x (v 0) (v 1) := by
  let g : E → F := fun y => iteratedFDeriv ℝ n f y (Fin.tail (Fin.tail v))
  have hT : ContDiff ℝ ∞ (iteratedFDeriv ℝ n f) :=
    hf.iteratedFDeriv_right le_rfl
  have hg : ContDiff ℝ ∞ g :=
    (ContinuousMultilinearMap.apply ℝ (fun _ : Fin n => E) F
      (Fin.tail (Fin.tail v))).contDiff.comp hT
  have hD : ∀ y, DifferentiableAt ℝ (iteratedFDeriv ℝ n f) y :=
    hT.differentiable (by simp)
  have hD' : DifferentiableAt ℝ (iteratedFDeriv ℝ (n + 1) f) x :=
    (hf.differentiable_iteratedFDeriv (n := ∞) (m := n + 1)
      (ENat.natCast_lt_of_coe_top_le_withTop le_rfl (n + 1))).differentiableAt
  have heq : (fun y => iteratedFDeriv ℝ (n + 1) f y (Fin.tail v)) =
      (fun y => fderiv ℝ g y (v 1)) := by
    funext y
    exact (hD y).iteratedFDeriv_succ_apply_left'
  rw [hD'.iteratedFDeriv_succ_apply_left', heq]
  rw [fderiv_clm_apply ((hg.fderiv_right (m := ∞) (by simp)).differentiable (by simp) x)
    (differentiableAt_const (v 1))]
  simp [g]

/-- Schwarz's theorem in iterated form: `∇ⁿ⁺²f(x)` is invariant under swapping its first two
indices. -/
theorem iteratedFDeriv_comp_swap_zero_one {f : E → F} (hf : ContDiff ℝ ∞ f) (n : ℕ) (x : E)
    (v : Fin (n + 2) → E) :
    iteratedFDeriv ℝ (n + 2) f x (v ∘ Equiv.swap 0 1) = iteratedFDeriv ℝ (n + 2) f x v := by
  have htail : Fin.tail (Fin.tail (v ∘ Equiv.swap 0 1)) = Fin.tail (Fin.tail v) := by
    ext i
    simp only [Fin.tail, Function.comp_apply]
    rw [Equiv.swap_apply_of_ne_of_ne (Fin.succ_ne_zero i.succ)
      (show i.succ.succ ≠ (1 : Fin (n + 2)) by
        intro h
        have hv := congrArg Fin.val h
        simp only [Fin.val_succ, Fin.val_one] at hv
        omega)]
  rw [iteratedFDeriv_add_two_apply_left hf, iteratedFDeriv_add_two_apply_left hf]
  simp only [Function.comp_apply, Equiv.swap_apply_left, Equiv.swap_apply_right, htail]
  have hT : ContDiff ℝ ∞ (iteratedFDeriv ℝ n f) :=
    hf.iteratedFDeriv_right le_rfl
  have hg : ContDiff ℝ ∞ (fun y => iteratedFDeriv ℝ n f y (Fin.tail (Fin.tail v))) :=
    (ContinuousMultilinearMap.apply ℝ (fun _ : Fin n => E) F
      (Fin.tail (Fin.tail v))).contDiff.comp hT
  exact (hg.contDiffAt.isSymmSndFDerivAt (by
    rw [minSmoothness_of_isRCLikeNormedField]
    exact le_of_lt (ENat.natCast_lt_of_coe_top_le_withTop le_rfl 2)))
    (v 1) (v 0)

/-- Symmetry of the iterated derivatives of a `C^∞` map from a real inner product space to a real
normed space:
`∇ⁿf(x)(v ∘ σ) = ∇ⁿf(x)(v)` for every permutation `σ`. (Mathlib's
`ContDiffAt.iteratedFDeriv_comp_perm` requires analyticity.) -/
theorem iteratedFDeriv_comp_perm_of_contDiff {f : E → F} (hf : ContDiff ℝ ∞ f) (n : ℕ) (x : E)
    (v : Fin n → E) (σ : Equiv.Perm (Fin n)) :
    iteratedFDeriv ℝ n f x (v ∘ σ) = iteratedFDeriv ℝ n f x v := by
    induction n generalizing x with
    | zero =>
        have hv : v ∘ σ = v := Subsingleton.elim _ _
        rw [hv]
    | succ n ih =>
        have hfix :
            ∀ (y : E) (w : Fin (n + 1) → E) (τ : Equiv.Perm (Fin (n + 1))),
              τ 0 = 0 →
                iteratedFDeriv ℝ (n + 1) f y (w ∘ τ) =
                  iteratedFDeriv ℝ (n + 1) f y w := by
          intro y w τ hτ
          exact
            iteratedFDeriv_succ_comp_perm_of_fix_zero hf
              (fun z u ρ => ih z u ρ) y w τ hτ
        have hmul :
            ∀ (α β : Equiv.Perm (Fin (n + 1))),
              (∀ (y : E) (w : Fin (n + 1) → E),
                iteratedFDeriv ℝ (n + 1) f y (w ∘ α) =
                  iteratedFDeriv ℝ (n + 1) f y w) →
              (∀ (y : E) (w : Fin (n + 1) → E),
                iteratedFDeriv ℝ (n + 1) f y (w ∘ β) =
                  iteratedFDeriv ℝ (n + 1) f y w) →
              ∀ (y : E) (w : Fin (n + 1) → E),
                iteratedFDeriv ℝ (n + 1) f y
                    (w ∘ (α * β : Equiv.Perm (Fin (n + 1)))) =
                  iteratedFDeriv ℝ (n + 1) f y w := by
          intro α β hα hβ y w
          have hcomp :
              w ∘ (α * β : Equiv.Perm (Fin (n + 1))) =
                (w ∘ α) ∘ β := by
            ext z
            rfl
          calc
            iteratedFDeriv ℝ (n + 1) f y
                (w ∘ (α * β : Equiv.Perm (Fin (n + 1)))) =
                iteratedFDeriv ℝ (n + 1) f y ((w ∘ α) ∘ β) := by
                  rw [hcomp]
            _ = iteratedFDeriv ℝ (n + 1) f y (w ∘ α) :=
              hβ y (w ∘ α)
            _ = iteratedFDeriv ℝ (n + 1) f y w :=
              hα y w
        cases n with
        | zero =>
            have hσ : σ 0 = 0 := Fin.eq_zero _
            exact hfix x v σ hσ
        | succ m =>
            let s : Equiv.Perm (Fin (m + 2)) := Equiv.swap 0 1
            have hs :
                ∀ (y : E) (w : Fin (m + 2) → E),
                  iteratedFDeriv ℝ (m + 2) f y (w ∘ s) =
                    iteratedFDeriv ℝ (m + 2) f y w := by
              intro y w
              simpa [s] using
                (iteratedFDeriv_comp_swap_zero_one (f := f) hf m y w)
            by_cases hk : σ 0 = 0
            · exact hfix x v σ hk
            · let a : Equiv.Perm (Fin (m + 2)) := Equiv.swap 1 (σ 0)
              let σ₁ : Equiv.Perm (Fin (m + 2)) := s * a * σ
              have h01 : (0 : Fin (m + 2)) ≠ 1 := by
                intro h
                have hh : (0 : ℕ) = 1 := congrArg Fin.val h
                exact Nat.zero_ne_one hh
              have h0k : (0 : Fin (m + 2)) ≠ σ 0 := by
                intro h
                apply hk
                exact h.symm
              have ha0 : a 0 = 0 := by
                simp [a, Equiv.swap_apply_of_ne_of_ne, h01, h0k]
              have hak : a (σ 0) = 1 := by
                simp [a]
              have hσ₁0 : σ₁ 0 = 0 := by
                simp only [σ₁, Equiv.Perm.coe_mul]
                simp [s, hak]
              have ha :
                  ∀ (y : E) (w : Fin (m + 2) → E),
                    iteratedFDeriv ℝ (m + 2) f y (w ∘ a) =
                      iteratedFDeriv ℝ (m + 2) f y w := by
                intro y w
                exact hfix y w a ha0
              have hσ₁ :
                  ∀ (y : E) (w : Fin (m + 2) → E),
                    iteratedFDeriv ℝ (m + 2) f y (w ∘ σ₁) =
                      iteratedFDeriv ℝ (m + 2) f y w := by
                intro y w
                exact hfix y w σ₁ hσ₁0
              have hσeq : a * s * σ₁ = σ := by
                calc
                  a * s * σ₁ = a * s * (s * a * σ) := by
                    rfl
                  _ = a * (s * s) * (a * σ) := by
                    simp only [mul_assoc]
                  _ = σ := by
                    simp [s, a]
              have hp :
                  iteratedFDeriv ℝ (m + 2) f x
                      (v ∘ (a * s * σ₁ : Equiv.Perm (Fin (m + 2)))) =
                    iteratedFDeriv ℝ (m + 2) f x v := by
                exact
                  hmul (a * s : Equiv.Perm (Fin (m + 2))) σ₁
                    (hmul a s ha hs) hσ₁ x v
              simpa [hσeq] using hp

/-- **Local symmetry of iterated derivatives**: for `f ∈ C^∞(U)`, `U` open, the iterated
derivatives at `x ∈ U` are symmetric in their arguments (localization of
`iteratedFDeriv_comp_perm_of_contDiff` by a smooth cutoff). -/
theorem iteratedFDeriv_comp_perm_of_contDiffOn {U : Set E} (hU : IsOpen U) {f : E → F}
    (hf : ContDiffOn ℝ ∞ f U) (n : ℕ) {x : E} (hx : x ∈ U) (σ : Equiv.Perm (Fin n))
    (v : Fin n → E) :
    iteratedFDeriv ℝ n f x (v ∘ σ) = iteratedFDeriv ℝ n f x v := by
      obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hU x hx
      let b : ContDiffBump x :=
        ⟨ε / 4, ε / 2, by positivity, by linarith⟩
      let g : E → F := fun y => b y • f y
      have hgf : g =ᶠ[nhds x] f := by
        filter_upwards [b.eventuallyEq_one] with y hy
        simp [g, hy]
      have hg : ContDiff ℝ ∞ g := by
        rw [contDiff_iff_contDiffAt]
        intro y
        by_cases hy : y ∈ Metric.ball x ε
        · have h1 : ContDiffOn ℝ ∞ g (Metric.ball x ε) := by
            exact (b.contDiff.contDiffOn).smul (hf.mono hball)
          exact h1.contDiffAt (Metric.isOpen_ball.mem_nhds hy)
        · have hopen : IsOpen (Metric.closedBall x (ε / 2))ᶜ :=
            Metric.isClosed_closedBall.isOpen_compl
          have hgzero : ContDiffOn ℝ ∞ g (Metric.closedBall x (ε / 2))ᶜ := by
            refine
              (contDiffOn_const :
                ContDiffOn ℝ ∞ (fun _ : E => (0 : F))
                  (Metric.closedBall x (ε / 2))ᶜ).congr ?_
            intro z hz
            have hdist : ε / 2 < dist z x := by
              simpa [Metric.mem_closedBall] using hz
            change b z • f z = 0
            rw [b.zero_of_le_dist (le_of_lt hdist)]
            simp
          have hy' : y ∈ (Metric.closedBall x (ε / 2))ᶜ := by
            have hεy : ε ≤ dist y x := by
              exact le_of_not_gt (by
                intro h
                exact hy (Metric.mem_ball.mpr h))
            have hdist : ε / 2 < dist y x := by
              linarith
            simpa [Metric.mem_closedBall] using (not_le_of_gt hdist)
          exact hgzero.contDiffAt (hopen.mem_nhds hy')
      have h1 : iteratedFDeriv ℝ n g x = iteratedFDeriv ℝ n f x := by
        rw [← iteratedFDerivWithin_univ, ← iteratedFDerivWithin_univ]
        exact
          Filter.EventuallyEq.iteratedFDerivWithin_eq
            (by simpa [nhdsWithin_univ] using hgf) hgf.eq_of_nhds n
      rw [← h1]
      exact iteratedFDeriv_comp_perm_of_contDiff hg n x v σ

end Symmetry

section LocalCalculus

variable {E F G : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G] [NormedSpace ℝ G]

/-- **Chain rule for iterated derivatives along a continuous linear map, on an open set**:
`∇ⁿ(g ∘ L)(x) = ∇ⁿg(Lx) ∘ (L, …, L)` when `g ∈ Cⁿ(U)`, `U` open, `Lx ∈ U`. -/
theorem iteratedFDeriv_comp_clm_of_isOpen {U : Set F} (hU : IsOpen U) {g : F → G} {n : ℕ}
    (hg : ContDiffOn ℝ n g U) (L : E →L[ℝ] F) {x : E} (hx : L x ∈ U) :
    iteratedFDeriv ℝ n (g ∘ L) x =
      (iteratedFDeriv ℝ n g (L x)).compContinuousLinearMap fun _ => L := by
    have hL : IsOpen (L ⁻¹' U) := hU.preimage L.continuous
    have hxL : x ∈ L ⁻¹' U := hx
    have hleft :
        iteratedFDerivWithin ℝ n (g ∘ L) (L ⁻¹' U) x =
          iteratedFDeriv ℝ n (g ∘ L) x :=
      (iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) n hL) hxL
    have hright :
        iteratedFDerivWithin ℝ n g U (L x) =
          iteratedFDeriv ℝ n g (L x) :=
      (iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) n hU) hx
    calc
      iteratedFDeriv ℝ n (g ∘ L) x =
          iteratedFDerivWithin ℝ n (g ∘ L) (L ⁻¹' U) x := hleft.symm
      _ =
          (iteratedFDerivWithin ℝ n g U (L x)).compContinuousLinearMap
            (fun _ : Fin n => L) := by
        exact
          ContinuousLinearMap.iteratedFDerivWithin_comp_right
            L hg hU.uniqueDiffOn hL.uniqueDiffOn hx le_rfl
      _ =
          (iteratedFDeriv ℝ n g (L x)).compContinuousLinearMap
            (fun _ : Fin n => L) := by
        rw [hright]

end LocalCalculus

end FunctionalInequalities.Analysis.BakryEmery
