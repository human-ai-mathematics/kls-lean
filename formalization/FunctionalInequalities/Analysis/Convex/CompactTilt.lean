module

public import FunctionalInequalities.Analysis.Convex.Subgradient.Basic
public import FunctionalInequalities.Analysis.Convex.Subgradient.Existence
public import FunctionalInequalities.Analysis.Convex.Subgradient.Regularity
public import FunctionalInequalities.Analysis.Convex.Supremum
public import Mathlib.Topology.Maps.Proper.Basic
public import Mathlib.Analysis.Calculus.MeanValue

/-!
# Continuous optimizers of compact convex affine tilts

A real-valued continuous strictly convex potential on a nonempty compact set
has one optimizer for every affine tilt, and the actual optimizer depends
continuously on the slope. No finite-dimensional, complete-space, measure,
optimizer or derivative premise is required. Compact minima and the existing
closed supporting graph give the result; this is compact-dual preparation for
Letwin arXiv:2607.24164v1 Lemma 2.2 via BB arXiv:1207.6128v1 Theorem 2.24(ii),
not differentiability of the primal potential or a dual MA equation.
-/

@[expose] public section

section
open Set Metric Filter
open scoped RealInnerProductSpace Topology
namespace FunctionalInequalities.Analysis

section CompactConjugate

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- A true compact C0 strictly convex source GENERATES the unique minimizer
of EVERY affine tilt, and a continuous actual optimizer map. No optimizer,
support, finite supremum, graph agreement or derivative is input. -/
theorem exists_continuous_tilt_optimizer {u : E → ℝ} {K : Set E} (hK : IsCompact K)
    (hKn : K.Nonempty)
    (hu : StrictConvexOn ℝ K u) (hC : ContinuousOn u K) :
    ∃ P : E → E,
      Continuous P ∧
        ∀ p : E,
          P p ∈ K ∧
            (∀ y ∈ K, u (P p) + ⟪p, y - P p⟫ ≤ u y) ∧
              (∀ x ∈ K, (∀ y ∈ K, u x + ⟪p, y - x⟫ ≤ u y) → x = P p) := by
  classical
  have hmin (p : E) : ∃! x : E, x ∈ K ∧ ∀ y ∈ K, u x + ⟪p, y - x⟫ ≤ u y := by
    let F : E → ℝ := fun x => u x - ⟪p, x⟫
    have hlin : ConcaveOn ℝ K (fun x => ⟪p, x⟫) := (innerSL ℝ p).toLinearMap.concaveOn hu.1
    have hF : StrictConvexOn ℝ K F := hu.sub_concaveOn hlin
    have hFC : ContinuousOn F K := hC.sub ((innerSL ℝ p).continuous.continuousOn)
    obtain ⟨x, hx, hxm⟩ := hK.exists_isMinOn hKn hFC
    have hxs : ∀ y ∈ K, u x + ⟪p, y - x⟫ ≤ u y := by
      intro y hy
      have h := hxm hy
      dsimp [F] at h
      rw [inner_sub_right]
      linarith
    refine ⟨x, ⟨hx, hxs⟩, ?_⟩
    rintro y ⟨hy, hys⟩
    apply hF.eq_of_isMinOn ?_ hxm hy hx
    intro z hz
    have h := hys z hz
    dsimp [F]
    rw [inner_sub_right] at h
    linarith
  let P : E → E := fun p => (hmin p).choose
  have hP (p : E) : P p ∈ K ∧ ∀ y ∈ K, u (P p) + ⟪p, y - P p⟫ ≤ u y := (hmin p).choose_spec.1
  have huniq (p x : E) (hx : x ∈ K) (hp : ∀ y ∈ K, u x + ⟪p, y - x⟫ ≤ u y) : x = P p :=
    (hmin p).choose_spec.2 x ⟨hx, hp⟩
  let : CompactSpace K := isCompact_iff_compactSpace.mp hK
  have hgraph : IsClosed {q : K × E | ∀ y ∈ K, u q.1.val + ⟪q.2, y - q.1.val⟫ ≤ u y} :=
    isClosed_subgradient_graphOn hC
  let f : E → K := fun p => ⟨P p, (hP p).1⟩
  have hfC : Continuous f :=
    continuous_of_compact_closed_relation
      {q : K × E | ∀ y ∈ K, u q.1.val + ⟪q.2, y - q.1.val⟫ ≤ u y} hgraph f (fun p => (hP p).2)
      (fun p x hx => Subtype.ext (huniq p x.val x.property hx))
  have hcP : Continuous P := continuous_subtype_val.comp hfC
  exact ⟨P, hcP, fun p => ⟨(hP p).1, (hP p).2, huniq p⟩⟩


/-- An actual compact optimizer family generates its finite conjugate VALUE,
variational formula, convexity, Lipschitz bound and C1 with the SAME optimizer
as derivative. These ordinary optimizer inputs are GENERATED by the closed
source client; no value, finite supremum or derivative is assumed. -/
theorem exists_value_of_optimizer {u : E → ℝ} {K : Set E} (hK : IsCompact K) (P : E → E)
    (hPC : Continuous P)
    (hP : ∀ p, P p ∈ K ∧ ∀ y ∈ K, u (P p) + ⟪p, y - P p⟫ ≤ u y) :
    ∃ (ψ : E → ℝ) (L : NNReal),
      (∀ p, ψ p = sSup ((fun y => ⟪p, y⟫ - u y) '' K)) ∧
        (∀ p, ψ p = ⟪p, P p⟫ - u (P p)) ∧
          ConvexOn ℝ univ ψ ∧
            LipschitzWith L ψ ∧ ContDiff ℝ 1 ψ ∧ (∀ p, HasFDerivAt ψ (innerSL ℝ (P p)) p) := by
  let F : E → E → ℝ := fun p y => ⟪p, y⟫ - u y
  let ψ : E → ℝ := fun p => sSup (F p '' K)
  have hKn : K.Nonempty := ⟨P 0, (hP 0).1⟩
  have hb (p : E) : BddAbove (F p '' K) := by
    refine ⟨F p (P p), ?_⟩
    rintro _ ⟨y, hy, rfl⟩
    have hp := (hP p).2 y hy
    dsimp [F]
    rw [inner_sub_right] at hp
    linarith
  have hv (p : E) : ψ p = ⟪p, P p⟫ - u (P p) := by
    apply le_antisymm
    · apply csSup_le (hKn.image (F p))
      rintro _ ⟨y, hy, rfl⟩
      have hp := (hP p).2 y hy
      dsimp [F]
      rw [inner_sub_right] at hp
      linarith
    · exact le_csSup (hb p) ⟨P p, (hP p).1, rfl⟩
  have hF : ∀ y ∈ K, ConvexOn ℝ univ (fun p => F p y) := by
    intro y _hy
    have h := ((innerSL ℝ y).toLinearMap.convexOn convex_univ).add_const (-u y)
    convert h using 1
    ext p
    simp only [F, Pi.add_apply, ContinuousLinearMap.coe_coe, innerSL_apply_apply,
      sub_eq_add_neg, real_inner_comm]
  have hconv : ConvexOn ℝ univ ψ :=
    convexOn_sSup_image_of_bddAbove convex_univ hKn (fun y p => F p y) hF (fun p _hp => hb p)
  have hbounds (p q : E) :
    0 ≤ ψ q - ψ p - ⟪P p, q - p⟫ ∧ ψ q - ψ p - ⟪P p, q - p⟫ ≤ ⟪q - p, P q - P p⟫ := by
    have hp := (hP p).2 (P q) (hP q).1
    have hq := (hP q).2 (P p) (hP p).1
    rw [hv p, hv q]
    simp only [inner_sub_left, inner_sub_right] at hp hq ⊢
    simp only [real_inner_comm] at hp hq ⊢
    constructor <;> linarith
  have hd (p : E) : HasFDerivAt ψ (innerSL ℝ (P p)) p := by
    apply hasFDerivAt_of_variational_remainder hPC.continuousAt
    exact Filter.Eventually.of_forall (hbounds p)
  have hC1 : ContDiff ℝ 1 ψ :=
    contDiff_one_iff_hasFDerivAt.mpr
      ⟨fun p => innerSL ℝ (P p), (innerSL ℝ).continuous.comp hPC, hd⟩
  obtain ⟨R, hR, hKR⟩ := hK.isBounded.exists_pos_norm_le
  have hLip : LipschitzWith R.toNNReal ψ := by
    apply lipschitzWith_of_nnnorm_fderiv_le (fun p => (hd p).differentiableAt)
    intro p
    rw [(hd p).fderiv]
    apply NNReal.coe_le_coe.mp
    simp only [coe_nnnorm, innerSL_apply_norm, Real.coe_toNNReal R hR.le]
    exact hKR (P p) (hP p).1
  exact ⟨ψ, R.toNNReal, fun _ => rfl, hv, hconv, hLip, hC1, hd⟩

/-- ONLY actual compact C0 strictly convex data produce SAME P and C1 VALUE.
No optimizer/continuity/finiteness/regularity is a source premise. -/
theorem exists_compact_conjugate {u : E → ℝ} {K : Set E} (hK : IsCompact K) (hKn : K.Nonempty)
    (hu : StrictConvexOn ℝ K u)
    (hC : ContinuousOn u K) :
    ∃ (P : E → E) (ψ : E → ℝ) (L : NNReal),
      Continuous P ∧
        (∀ p,
            P p ∈ K ∧
              (∀ y ∈ K, u (P p) + ⟪p, y - P p⟫ ≤ u y) ∧
                ∀ x ∈ K, (∀ y ∈ K, u x + ⟪p, y - x⟫ ≤ u y) → x = P p) ∧
          (∀ p, ψ p = sSup ((fun y => ⟪p, y⟫ - u y) '' K)) ∧
            (∀ p, ψ p = ⟪p, P p⟫ - u (P p)) ∧
              ConvexOn ℝ univ ψ ∧
                LipschitzWith L ψ ∧ ContDiff ℝ 1 ψ ∧ (∀ p, HasFDerivAt ψ (innerSL ℝ (P p)) p) := by
  obtain ⟨P, hPC, hopt⟩ := exists_continuous_tilt_optimizer hK hKn hu hC
  obtain ⟨ψ, L, hs, hv, hcv, hL, hC1, hd⟩ :=
    exists_value_of_optimizer hK P hPC (fun p => ⟨(hopt p).1, (hopt p).2.1⟩)
  exact ⟨P, ψ, L, hPC, hopt, hs, hv, hcv, hL, hC1, hd⟩

/-- Actual compact optimizer uniqueness and ordinary convex localization give
exact primal supporting-image / SAME optimizer inverse-image identity strictly
inside K. No topological or measure conclusions are source inputs. -/
theorem subgradientImageOn_eq_optimizer_preimage {u : E → ℝ} {K D G : Set E} (hu : ConvexOn ℝ D u)
    (hKD : K ⊆ D)
    (P : E → E)
    (hP :
      ∀ p,
        P p ∈ K ∧
          (∀ y ∈ K, u (P p) + ⟪p, y - P p⟫ ≤ u y) ∧
            ∀ x ∈ K, (∀ y ∈ K, u x + ⟪p, y - x⟫ ≤ u y) → x = P p)
    (hG : G ⊆ interior K) : subgradientImageOn u D G = P ⁻¹' G := by
  ext p
  constructor
  · rintro ⟨x, hx, hpx⟩
    have he : x = P p := (hP p).2.2 x (interior_subset (hG hx)) (fun y hy => hpx y (hKD hy))
    change P p ∈ G
    simpa only [he] using hx
  · intro hp
    refine ⟨P p, hp, ?_⟩
    exact
      subgradient_le_on_of_isOpen hu isOpen_interior (interior_subset.trans hKD) (hG hp)
        (fun y hy => (hP p).2.1 y (interior_subset hy))


/-- Actual compact C0 source/real interior point and its literal Sup formula
GENERATE quantitative tilt coercivity on EVERY ambient point. No dimension,
completeness, measure, convexity, cap/finiteSup/coercivity input. -/
theorem exists_tilt_lower_bound_of_compact_sup {u ψ : E → ℝ} {K : Set E} (hK : IsCompact K)
    (hC : ContinuousOn u K)
    (hs : ∀ p, ψ p = sSup ((fun y => ⟪p, y⟫ - u y) '' K)) {x : E} (hx : x ∈ interior K) :
    ∃ δ C : ℝ, 0 < δ ∧ 0 < C ∧ ∀ p, δ * ‖p‖ - C ≤ ψ p - ⟪p, x⟫ := by
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp (mem_interior_iff_mem_nhds.mp hx)
  obtain ⟨z, hz, hmax⟩ := hK.exists_isMaxOn ⟨x, interior_subset hx⟩ hC
  let δ : ℝ := ε / 2
  let C : ℝ := |u z| + 1
  have hδ : 0 < δ := by dsimp [δ]; linarith
  have hδε : δ < ε := by dsimp [δ]; linarith
  have hCp : 0 < C := by dsimp [C]; positivity
  have hcap (y : E) (hy : y ∈ K) : u y ≤ C :=
    (hmax hy).trans ((le_abs_self (u z)).trans (by dsimp [C]; linarith))
  have hle (p y : E) (hy : y ∈ K) : ⟪p, y⟫ - u y ≤ ψ p := by
    rw [hs p]
    have hf : ContinuousOn (fun y => ⟪p, y⟫ - u y) K :=
      ((innerSL ℝ p).continuous.continuousOn).sub hC
    exact le_csSup (hK.bddAbove_image hf) ⟨y, hy, rfl⟩
  refine ⟨δ, C, hδ, hCp, ?_⟩
  intro p
  by_cases hp : p = 0
  · subst p
    have h := hle 0 x (interior_subset hx)
    have hc := hcap x (interior_subset hx)
    simp only [inner_zero_left, norm_zero, mul_zero, sub_zero] at h ⊢
    linarith
  · have hn : 0 < ‖p‖ := norm_pos_iff.mpr hp
    let y := x + (δ / ‖p‖) • p
    have hyn : dist y x = δ := by
      dsimp [y]
      rw [dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_eq_abs,
        abs_of_pos (div_pos hδ hn), div_mul_cancel₀ δ (ne_of_gt hn)]
    have hy : y ∈ K := hball (mem_ball.mpr (hyn.trans_lt hδε))
    have hdcalc : (δ / ‖p‖) * ‖p‖ ^ 2 = δ * ‖p‖ := by
      rw [pow_two, ← mul_assoc, div_mul_cancel₀ δ (ne_of_gt hn)]
    have hinner : ⟪p, y⟫ = ⟪p, x⟫ + δ * ‖p‖ := by
      dsimp [y]
      rw [inner_add_right, real_inner_smul_right, real_inner_self_eq_norm_sq, hdcalc]
    have hl := hle p y hy
    have hc := hcap y hy
    rw [hinner] at hl
    linarith

end CompactConjugate

/-- Finite dimension is used ONLY after the actual bound to make FULL ambient
tilt sublevels compact. No source compact-sublevel/coercivity premise. -/
theorem exists_compact_tilt_sublevels {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] {u ψ : E → ℝ} {K : Set E} (hK : IsCompact K) (hC : ContinuousOn u K)
    (hψ : Continuous ψ) (hs : ∀ p, ψ p = sSup ((fun y => ⟪p, y⟫ - u y) '' K)) {x : E}
    (hx : x ∈ interior K) :
    ∃ δ C : ℝ,
      0 < δ ∧
        0 < C ∧ (∀ p, δ * ‖p‖ - C ≤ ψ p - ⟪p, x⟫) ∧ ∀ R : ℝ, IsCompact {p | ψ p - ⟪p, x⟫ ≤ R} := by
  obtain ⟨δ, C, hδ, hCp, hl⟩ := exists_tilt_lower_bound_of_compact_sup hK hC hs hx
  refine ⟨δ, C, hδ, hCp, hl, ?_⟩
  intro R
  apply isCompact_iff_isClosed_bounded.mpr
  refine ⟨isClosed_le (hψ.sub (continuous_id.inner continuous_const)) continuous_const, ?_⟩
  apply isBounded_iff_forall_norm_le.mpr
  refine ⟨(R + C) / δ, ?_⟩
  intro p hp
  have hp' : ψ p - ⟪p, x⟫ ≤ R := hp
  apply (le_div_iff₀ hδ).mpr
  nlinarith [hl p]


/-- Actual compact full sublevels/minimum and an open set containing EVERY
minimum contact GENERATE a positive level gap/contained full section. -/
private lemma compact_sublevel_subset_of_minimum {E : Type*} [TopologicalSpace E] {F : E → ℝ}
    (hF : Continuous F) (hcomp : ∀ R : ℝ, IsCompact {p | F p ≤ R}) {D : Set E} (hD : IsOpen D)
    (p₀ : E) (hmin : ∀ p, F p₀ ≤ F p) (hcontact : ∀ p, F p = F p₀ → p ∈ D) :
    ∃ R : ℝ, F p₀ < R ∧ IsCompact {p | F p ≤ R} ∧ {p | F p ≤ R} ⊆ D := by
  let S : Set E := {p | F p ≤ F p₀ + 1} ∩ Dᶜ
  have hS : IsCompact S := (hcomp (F p₀ + 1)).inter_right hD.isClosed_compl
  have hs (p : E) (hp : p ∈ S) : F p₀ < F p := by
    apply lt_of_le_of_ne (hmin p)
    intro he
    exact hp.2 (hcontact p he.symm)
  obtain ⟨b, hb, hSb⟩ := hS.exists_forall_le' hF.continuousOn hs
  let R : ℝ := min (F p₀ + 1) ((F p₀ + b) / 2)
  have hR : F p₀ < R := lt_min (by linarith) (by linarith)
  refine ⟨R, hR, hcomp R, ?_⟩
  intro p hp
  by_contra hn
  have hpR : F p ≤ R := hp
  have hpin : p ∈ S := ⟨show F p ≤ F p₀ + 1 from hpR.trans (min_le_left _ _), hn⟩
  have h1 := hSb p hpin
  have h2 := hpR.trans (min_le_right (F p₀ + 1) ((F p₀ + b) / 2))
  linarith

/-- Actual C0 primal/compact conjugate data GENERATE a slope/minimum, proper
full sections and a positive gap confining a section to the SAME slope region.
No source support/contact/gap/compact-section/containment input. -/
theorem exists_contained_dual_section {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] {u ψ : E → ℝ} {K D : Set E} (hD : IsOpen D) (hu : ConvexOn ℝ D u)
    (hC : ContinuousOn u D) (hK : IsCompact K) (hKD : K ⊆ D) (P : E → E) (hPC : Continuous P)
    (hP :
      ∀ p,
        P p ∈ K ∧
          (∀ y ∈ K, u (P p) + ⟪p, y - P p⟫ ≤ u y) ∧
            ∀ x ∈ K, (∀ y ∈ K, u x + ⟪p, y - x⟫ ≤ u y) → x = P p)
    (hψ : Continuous ψ) (hs : ∀ p, ψ p = sSup ((fun y => ⟪p, y⟫ - u y) '' K))
    (hv : ∀ p, ψ p = ⟪p, P p⟫ - u (P p)) {x : E} (hx : x ∈ interior K) :
    ∃ (p₀ : E) (R : ℝ),
      P p₀ = x ∧
        ψ p₀ - ⟪p₀, x⟫ = -u x ∧
          -u x < R ∧
            IsCompact {p | ψ p - ⟪p, x⟫ ≤ R} ∧ {p | ψ p - ⟪p, x⟫ ≤ R} ⊆ P ⁻¹' interior K := by
  have hxK : x ∈ K := interior_subset hx
  obtain ⟨B, _hB, hsex, _hcap⟩ :=
    exists_uniform_subgradient_bound_on_compact hD hu hC isCompact_singleton
      (singleton_subset_iff.mpr (hKD hxK))
  obtain ⟨p₀, hp₀⟩ := hsex x (mem_singleton x)
  have hPx : P p₀ = x := ((hP p₀).2.2 x hxK (fun y hy => hp₀ y (hKD hy))).symm
  let F : E → ℝ := fun p => ψ p - ⟪p, x⟫
  have hf0 : F p₀ = -u x := by
    dsimp [F]
    rw [hv p₀, hPx]
    ring
  have hmin (p : E) : F p₀ ≤ F p := by
    rw [hf0]
    have hh := (hP p).2.1 x hxK
    dsimp [F]
    rw [hv p]
    rw [inner_sub_right] at hh
    linarith
  have hcontact (p : E) (he : F p = F p₀) : p ∈ P ⁻¹' interior K := by
    have hvx : ⟪p, P p⟫ - u (P p) - ⟪p, x⟫ = -u x := by simpa only [F, hv p, hf0] using he
    have hxs (y : E) (hy : y ∈ K) : u x + ⟪p, y - x⟫ ≤ u y := by
      have hh := (hP p).2.1 y hy
      rw [inner_sub_right] at hh ⊢
      linarith
    have heP : x = P p := (hP p).2.2 x hxK hxs
    change P p ∈ interior K
    simpa only [← heP] using hx
  obtain ⟨δ, C, _hδ, _hCp, _hgrowth, hcomp⟩ :=
    exists_compact_tilt_sublevels hK (hC.mono hKD) hψ hs hx
  obtain ⟨R, hR, hRc, hRD⟩ :=
    compact_sublevel_subset_of_minimum (hψ.sub (continuous_id.inner continuous_const)) hcomp
      (isOpen_interior.preimage hPC) p₀ hmin hcontact
  change F p₀ < R at hR
  rw [hf0] at hR
  exact ⟨p₀, R, hPx, hf0, hR, hRc, hRD⟩



end FunctionalInequalities.Analysis
