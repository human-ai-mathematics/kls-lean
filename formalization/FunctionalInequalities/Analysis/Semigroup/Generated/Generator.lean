      ≤ t⁻¹ * (7 * ε / 8 * t) :=
    mul_le_mul_of_nonneg_left (hq t htpos htδ) (inv_pos.mpr htpos).le
  have h2 : t⁻¹ * (7 * ε / 8 * t) = 7 * ε / 8 := by field_simp
  linarith

end Generator

