import FunctionalInequalities.Analysis.Semigroup.Generated.Laws
import FunctionalInequalities.Energy.Form.Dirichlet
import FunctionalInequalities.Energy.Relaxation.LinearPMap
import FunctionalInequalities.L2.MeanVariance
import Mathlib.MeasureTheory.Function.LpOrder

/-!
# Markov semigroups generated by closed real `L²` forms

This module proves the abstract Beurling--Deny part of gap 2 in the KLS Buser program. Let
`T : L²(μ) →ₗ.[ℝ] H` be closed and densely defined. If its squared-norm energy is Markovian under
all normal contractions and the constant one belongs to `D(T)` with `T 1 = 0`, then the weak
resolvents, their Yosida exponentials, and the generated semigroup preserve positivity and the
constant one. Consequently the semigroup is sub-Markov, preserves the mean, satisfies
`|P_t f| ≤ P_t |f|`, and contracts every finite essential bound.

The proof is entirely abstract Hilbert/lattice algebra. It supplies no `Γ`-calculus, no heat
estimate, and no step of Buser's inequality.
-/

noncomputable section

open Filter InnerProductSpace MeasureTheory Topology
open scoped RealInnerProductSpace

namespace FunctionalInequalities.Analysis.Semigroup

namespace LpMarkov

variable {α H : Type*} [MeasurableSpace α]
  [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- The positive-part map as a normal contraction of the real line. -/
def positivePart : Energy.NormalContraction where
  toFun x := max x 0
  lipschitz := Lp.lipschitzWith_pos_part
  map_zero := max_eq_right le_rfl

/-- Upper truncation at one as a normal contraction of the real line. -/
def upperOne : Energy.NormalContraction where
  toFun x := min x 1
  lipschitz := LipschitzWith.min_const LipschitzWith.id 1
  map_zero := min_eq_left zero_le_one

variable (μ : ProbabilityMeasure α)

/-- Acting by the positive-part normal contraction is lattice positive part in `L²`. -/
theorem positivePart_compL2 (f : Lp ℝ 2 (μ : Measure α)) :
    positivePart.compL2 (μ : Measure α) f = f ⊔ 0 := by
  apply Lp.ext
  filter_upwards [positivePart.coeFn_compL2 (μ : Measure α) f,
    Lp.coeFn_sup f 0, Lp.coeFn_zero ℝ 2 (μ : Measure α)] with x hcomp hsup hzero
  rw [hcomp, hsup]
  simp [positivePart]

/-- Acting by upper truncation at one is lattice infimum with the `L²` constant one. -/
theorem upperOne_compL2 (f : Lp ℝ 2 (μ : Measure α)) :
    upperOne.compL2 (μ : Measure α) f = f ⊓ L2.const μ 1 := by
  apply Lp.ext
  filter_upwards [upperOne.coeFn_compL2 (μ : Measure α) f,
    Lp.coeFn_inf f (L2.const μ 1), L2.const_coeFn μ 1] with x hcomp hinf hone
  rw [hcomp, hinf]
  simp [upperOne, hone]

variable {μ : ProbabilityMeasure α} {T : Lp ℝ 2 (μ : Measure α) →ₗ.[ℝ] H}

omit [CompleteSpace H] in
/-- A Markovian squared-norm form is stable on the operator domain under every normal
contraction, with nonincreasing operator norm. -/
theorem compL2_mem_domain_and_norm_le
    (hM : Energy.Markovian (μ : Measure α) (Energy.PreEnergy.normSqEnergy T))
    (φ : Energy.NormalContraction) (u : T.domain) :
    ∃ hu : φ.compL2 (μ : Measure α) u ∈ T.domain,
      ‖T ⟨φ.compL2 (μ : Measure α) u, hu⟩‖ ≤ ‖T u‖ := by
  have henergy := hM φ (u : Lp ℝ 2 (μ : Measure α))
  rw [Energy.PreEnergy.normSqEnergy_of_mem T u] at henergy
  have hmem : φ.compL2 (μ : Measure α) u ∈ T.domain := by
    by_contra hnot
    rw [Energy.PreEnergy.normSqEnergy_of_notMem T hnot] at henergy
    exact ENNReal.not_top_le_coe henergy
  refine ⟨hmem, ?_⟩
  rw [Energy.PreEnergy.normSqEnergy_of_mem T
    ⟨φ.compL2 (μ : Measure α) u, hmem⟩] at henergy
  have hsquare := ENNReal.coe_le_coe.mp henergy
  have hnn := (sq_le_sq₀ (show (0 : NNReal) ≤ _ from bot_le)
    (show (0 : NNReal) ≤ _ from bot_le)).mp hsquare
  exact_mod_cast hnn

omit [CompleteSpace H] in
/-- The weak resolvent solution uniquely minimizes
`v ↦ ‖v-f‖² + s‖Tv‖²` on the form domain. -/
theorem eq_resolventDomain_of_objective_le {s : ℝ} (hs : 0 < s) {f : Lp ℝ 2 (μ : Measure α)}
    {u v : T.domain} (hu : WeakResolvent T s f u)
    (hle : ‖(v : Lp ℝ 2 (μ : Measure α)) - f‖ ^ 2 + s * ‖T v‖ ^ 2 ≤
      ‖(u : Lp ℝ 2 (μ : Measure α)) - f‖ ^ 2 + s * ‖T u‖ ^ 2) :
    v = u := by
  have hweak := hu (v - u)
  have hTsub : T (v - u) = T v - T u := T.map_sub v u
  have hcoe : ((v - u : T.domain) : Lp ℝ 2 (μ : Measure α)) = v - u := rfl
  rw [hcoe, hTsub] at hweak
  simp only [inner_sub_right] at hweak
  have hid :
      ‖(v : Lp ℝ 2 (μ : Measure α)) - f‖ ^ 2 + s * ‖T v‖ ^ 2 =
        ‖(u : Lp ℝ 2 (μ : Measure α)) - f‖ ^ 2 + s * ‖T u‖ ^ 2 +
          ‖(v : Lp ℝ 2 (μ : Measure α)) - u‖ ^ 2 + s * ‖T (v - u)‖ ^ 2 := by
    rw [hTsub]
    simp only [← real_inner_self_eq_norm_sq, inner_sub_left, inner_sub_right]
    nlinarith [real_inner_comm (v : Lp ℝ 2 (μ : Measure α)) u,
      real_inner_comm (T v) (T u), real_inner_comm f (v : Lp ℝ 2 (μ : Measure α)),
      real_inner_comm f (u : Lp ℝ 2 (μ : Measure α))]
  rw [hid] at hle
  have hz : ‖(v : Lp ℝ 2 (μ : Measure α)) - u‖ = 0 := by
    nlinarith [sq_nonneg ‖(v : Lp ℝ 2 (μ : Measure α)) - u‖,
      sq_nonneg ‖T (v - u)‖]
  exact Subtype.ext (sub_eq_zero.mp (norm_eq_zero.mp hz))

/-- A Markovian closed form has a positivity-preserving resolvent. -/
theorem resolventCLM_positive (hT : T.IsClosed)
    (hM : Energy.Markovian (μ : Measure α) (Energy.PreEnergy.normSqEnergy T))
    {s : ℝ} (hs : 0 < s) {f : Lp ℝ 2 (μ : Measure α)} (hf : 0 ≤ f) :
    0 ≤ resolventCLM T hT hs f := by
  let u := resolventDomain T hT hs f
  obtain ⟨hpos, hTpos⟩ := compL2_mem_domain_and_norm_le hM positivePart u
  let v : T.domain := ⟨positivePart.compL2 (μ : Measure α) u, hpos⟩
  have hvcoe : (v : Lp ℝ 2 (μ : Measure α)) = (u : Lp ℝ 2 (μ : Measure α)) ⊔ 0 := by
    exact positivePart_compL2 μ u
  have hfn : f ⊔ 0 = f := sup_eq_left.mpr hf
  have hdist : ‖(v : Lp ℝ 2 (μ : Measure α)) - f‖ ≤ ‖(u : Lp ℝ 2 (μ : Measure α)) - f‖ := by
    calc
      ‖(v : Lp ℝ 2 (μ : Measure α)) - f‖ =
          ‖((u : Lp ℝ 2 (μ : Measure α)) ⊔ 0) - (f ⊔ 0)‖ := by rw [hvcoe, hfn]
      _ ≤ ‖(u : Lp ℝ 2 (μ : Measure α)) - f‖ :=
        norm_le_norm_of_abs_le_abs (abs_sup_sub_sup_le_abs _ _ _)
  have hobj : ‖(v : Lp ℝ 2 (μ : Measure α)) - f‖ ^ 2 + s * ‖T v‖ ^ 2 ≤
      ‖(u : Lp ℝ 2 (μ : Measure α)) - f‖ ^ 2 + s * ‖T u‖ ^ 2 := by
    gcongr
  have hvu : v = u := eq_resolventDomain_of_objective_le hs
    (resolventDomain_spec T hT hs f) hobj
  have hcoe_eq : (v : Lp ℝ 2 (μ : Measure α)) = u := congrArg Subtype.val hvu
  rw [resolventCLM_apply]
  change 0 ≤ (u : Lp ℝ 2 (μ : Measure α))
  rw [← hcoe_eq, hvcoe]
  exact le_sup_right

/-- A Markovian closed form has an upper-one-preserving resolvent. -/
theorem resolventCLM_le_one (hT : T.IsClosed)
    (hM : Energy.Markovian (μ : Measure α) (Energy.PreEnergy.normSqEnergy T))
    {s : ℝ} (hs : 0 < s) {f : Lp ℝ 2 (μ : Measure α)} (hf : f ≤ L2.const μ 1) :
    resolventCLM T hT hs f ≤ L2.const μ 1 := by
  let u := resolventDomain T hT hs f
  obtain ⟨hcap, hTcap⟩ := compL2_mem_domain_and_norm_le hM upperOne u
  let v : T.domain := ⟨upperOne.compL2 (μ : Measure α) u, hcap⟩
  have hvcoe : (v : Lp ℝ 2 (μ : Measure α)) =
      (u : Lp ℝ 2 (μ : Measure α)) ⊓ L2.const μ 1 := by
    exact upperOne_compL2 μ u
  have hfn : f ⊓ L2.const μ 1 = f := inf_eq_left.mpr hf
  have hdist : ‖(v : Lp ℝ 2 (μ : Measure α)) - f‖ ≤ ‖(u : Lp ℝ 2 (μ : Measure α)) - f‖ := by
    calc
      ‖(v : Lp ℝ 2 (μ : Measure α)) - f‖ =
          ‖((u : Lp ℝ 2 (μ : Measure α)) ⊓ L2.const μ 1) -
            (f ⊓ L2.const μ 1)‖ := by rw [hvcoe, hfn]
      _ ≤ ‖(u : Lp ℝ 2 (μ : Measure α)) - f‖ :=
        norm_le_norm_of_abs_le_abs (abs_inf_sub_inf_le_abs _ _ _)
  have hobj : ‖(v : Lp ℝ 2 (μ : Measure α)) - f‖ ^ 2 + s * ‖T v‖ ^ 2 ≤
      ‖(u : Lp ℝ 2 (μ : Measure α)) - f‖ ^ 2 + s * ‖T u‖ ^ 2 := by
    gcongr
  have hvu : v = u := eq_resolventDomain_of_objective_le hs
    (resolventDomain_spec T hT hs f) hobj
  have hcoe_eq : (v : Lp ℝ 2 (μ : Measure α)) = u := congrArg Subtype.val hvu
  rw [resolventCLM_apply]
  change (u : Lp ℝ 2 (μ : Measure α)) ≤ L2.const μ 1
  rw [← hcoe_eq, hvcoe]
  exact inf_le_right

/-- If one lies in the form domain and has zero energy, every resolvent fixes it. -/
theorem resolventCLM_one (hT : T.IsClosed) {s : ℝ} (hs : 0 < s)
    (hone : L2.const μ 1 ∈ T.domain) (hTone : T ⟨L2.const μ 1, hone⟩ = 0) :
    resolventCLM T hT hs (L2.const μ 1) = L2.const μ 1 := by
  let oneDom : T.domain := ⟨L2.const μ 1, hone⟩
  have hweak : WeakResolvent T s (L2.const μ 1) oneDom := by
    intro v
    change ⟪L2.const μ 1, (v : Lp ℝ 2 (μ : Measure α))⟫ + s * ⟪T oneDom, T v⟫ = _
    rw [hTone, inner_zero_left, mul_zero, add_zero]
  rw [resolventCLM_apply, ← eq_resolventDomain T hT hs hweak]

/-! ## Positivity and constants for the Yosida exponentials -/

/-- A continuous linear operator is positive when it preserves the positive cone. -/
def IsPositive (A : Lp ℝ 2 (μ : Measure α) →L[ℝ] Lp ℝ 2 (μ : Measure α)) : Prop :=
  ∀ ⦃f⦄, 0 ≤ f → 0 ≤ A f

omit [CompleteSpace H] in
/-- Nonnegative real scalar multiplication preserves the positive cone of real `L²`. -/
theorem smul_nonneg_Lp {c : ℝ} (hc : 0 ≤ c) {f : Lp ℝ 2 (μ : Measure α)} (hf : 0 ≤ f) :
    0 ≤ c • f := by
  rw [← Lp.coeFn_nonneg] at hf ⊢
  filter_upwards [hf, Lp.coeFn_smul c f] with x hfx hsmul
  rw [hsmul, Pi.smul_apply, smul_eq_mul]
  exact mul_nonneg hc hfx

omit [CompleteSpace H] in
/-- Positive operators are closed under nonnegative scalar multiplication. -/
theorem IsPositive.smul {A : Lp ℝ 2 (μ : Measure α) →L[ℝ] Lp ℝ 2 (μ : Measure α)}
    (hA : IsPositive A) {c : ℝ} (hc : 0 ≤ c) : IsPositive (c • A) := by
  intro f hf
  change 0 ≤ c • A f
  exact smul_nonneg_Lp hc (hA hf)

omit [CompleteSpace H] in
/-- Positive operators are closed under composition. -/
theorem IsPositive.comp
    {A B : Lp ℝ 2 (μ : Measure α) →L[ℝ] Lp ℝ 2 (μ : Measure α)}
    (hA : IsPositive A) (hB : IsPositive B) : IsPositive (A.comp B) := by
  intro f hf
  exact hA (hB hf)

omit [CompleteSpace H] in
/-- Every power of a positive operator is positive. -/
theorem IsPositive.pow {A : Lp ℝ 2 (μ : Measure α) →L[ℝ] Lp ℝ 2 (μ : Measure α)}
    (hA : IsPositive A) : ∀ n : ℕ, IsPositive (A ^ n)
  | 0 => by intro f hf; simpa using hf
  | n + 1 => by
      rw [pow_succ]
      exact (hA.pow n).comp hA

/-- The exponential of a positive bounded operator is positive. The proof takes the exponential
series through evaluation at `f`; every finite partial sum lies in the closed positive cone. -/
theorem isPositive_exp
    {A : Lp ℝ 2 (μ : Measure α) →L[ℝ] Lp ℝ 2 (μ : Measure α)}
    (hA : IsPositive A) : IsPositive (NormedSpace.exp A) := by
  intro f hf
  have hsum := (NormedSpace.exp_series_hasSum_exp' (𝕂 := ℝ) A).mapL
    (ContinuousLinearMap.apply ℝ (Lp ℝ 2 (μ : Measure α)) f)
  refine (isClosed_Ici : IsClosed (Set.Ici (0 : Lp ℝ 2 (μ : Measure α)))).mem_of_tendsto
    hsum.tendsto_sum_nat ?_
  filter_upwards with n
  exact Finset.sum_nonneg fun k _ ↦ by
    change 0 ≤ (k.factorial : ℝ)⁻¹ • (A ^ k) f
    exact smul_nonneg_Lp (inv_nonneg.mpr (Nat.cast_nonneg _)) ((hA.pow k) hf)

omit [CompleteSpace H] in
/-- Exponentiating an operator that kills `f` fixes `f`. -/
theorem exp_apply_of_apply_eq_zero
    (A : Lp ℝ 2 (μ : Measure α) →L[ℝ] Lp ℝ 2 (μ : Measure α))
    (f : Lp ℝ 2 (μ : Measure α)) (hAf : A f = 0) : NormedSpace.exp A f = f := by
  have hsum := (NormedSpace.exp_series_hasSum_exp' (𝕂 := ℝ) A).mapL
    (ContinuousLinearMap.apply ℝ (Lp ℝ 2 (μ : Measure α)) f)
  apply hsum.unique
  convert hasSum_ite_eq 0 f using 1
  ext n
  rcases n with _ | n
  · simp
  · simp [pow_succ, hAf]

omit [CompleteSpace H] in
/-- The exponential of a scalar multiple of the identity is scalar multiplication by the real
exponential. -/
theorem exp_smul_one_apply (a : ℝ) (f : Lp ℝ 2 (μ : Measure α)) :
    NormedSpace.exp (a • (1 : Lp ℝ 2 (μ : Measure α) →L[ℝ]
      Lp ℝ 2 (μ : Measure α))) f = Real.exp a • f := by
  have halg : a • (1 : Lp ℝ 2 (μ : Measure α) →L[ℝ] Lp ℝ 2 (μ : Measure α)) =
      algebraMap ℝ (Lp ℝ 2 (μ : Measure α) →L[ℝ] Lp ℝ 2 (μ : Measure α)) a :=
    (Algebra.algebraMap_eq_smul_one a).symm
  have hmap : NormedSpace.exp
      (algebraMap ℝ (Lp ℝ 2 (μ : Measure α) →L[ℝ] Lp ℝ 2 (μ : Measure α)) a) =
      algebraMap ℝ (Lp ℝ 2 (μ : Measure α) →L[ℝ]
        Lp ℝ 2 (μ : Measure α)) (NormedSpace.exp a) :=
    (NormedSpace.map_exp
      (algebraMap ℝ (Lp ℝ 2 (μ : Measure α) →L[ℝ] Lp ℝ 2 (μ : Measure α)))
      (continuous_algebraMap ℝ (Lp ℝ 2 (μ : Measure α) →L[ℝ]
        Lp ℝ 2 (μ : Measure α))) a).symm
  rw [halg, hmap, ← Real.exp_eq_exp_ℝ, Algebra.algebraMap_eq_smul_one]
  simp

/-- The Yosida exponential factors into a positive scalar exponential and the exponential of a
nonnegative scalar multiple of the resolvent. -/
theorem exp_neg_smul_yosida_factor (hT : T.IsClosed) {s : ℝ} (hs : 0 < s) (t : ℝ) :
    NormedSpace.exp (-t • yosida T hT hs) =
      NormedSpace.exp ((-t * s⁻¹) • (1 : Lp ℝ 2 (μ : Measure α) →L[ℝ]
        Lp ℝ 2 (μ : Measure α))) *
      NormedSpace.exp ((t * s⁻¹) • resolventCLM T hT hs) := by
  have hdecomp : -t • yosida T hT hs =
      (-t * s⁻¹) • (1 : Lp ℝ 2 (μ : Measure α) →L[ℝ] Lp ℝ 2 (μ : Measure α)) +
        (t * s⁻¹) • resolventCLM T hT hs := by
    apply ContinuousLinearMap.ext
    intro f
    change (-t) • yosida T hT hs f =
      (-t * s⁻¹) • f + (t * s⁻¹) • resolventCLM T hT hs f
    rw [yosida_apply]
    module
  rw [hdecomp]
  apply NormedSpace.exp_add_of_commute_of_mem_ball (𝕂 := ℝ)
  · have halg : (-t * s⁻¹) • (1 : Lp ℝ 2 (μ : Measure α) →L[ℝ]
        Lp ℝ 2 (μ : Measure α)) =
        algebraMap ℝ (Lp ℝ 2 (μ : Measure α) →L[ℝ]
          Lp ℝ 2 (μ : Measure α)) (-t * s⁻¹) :=
      (Algebra.algebraMap_eq_smul_one _).symm
    rw [halg]
    exact Algebra.commutes _ _
  · rw [NormedSpace.expSeries_radius_eq_top]
    exact edist_lt_top _ _
  · rw [NormedSpace.expSeries_radius_eq_top]
    exact edist_lt_top _ _

/-- Positivity of the Yosida exponential, obtained from the Poisson-series factorization and
positivity of the resolvent. -/
theorem isPositive_exp_neg_smul_yosida (hT : T.IsClosed)
    (hM : Energy.Markovian (μ : Measure α) (Energy.PreEnergy.normSqEnergy T))
    {s t : ℝ} (hs : 0 < s) (ht : 0 ≤ t) :
    IsPositive (NormedSpace.exp (-t • yosida T hT hs)) := by
  have hJ : IsPositive (resolventCLM T hT hs) := fun _ hf ↦
    resolventCLM_positive hT hM hs hf
  have hcoef : 0 ≤ t * s⁻¹ := mul_nonneg ht (inv_nonneg.mpr hs.le)
  have hexpJ := isPositive_exp ((hJ.smul hcoef))
  intro f hf
  rw [exp_neg_smul_yosida_factor hT hs t]
  change 0 ≤ NormedSpace.exp ((-t * s⁻¹) • (1 : Lp ℝ 2 (μ : Measure α) →L[ℝ]
    Lp ℝ 2 (μ : Measure α)))
      (NormedSpace.exp ((t * s⁻¹) • resolventCLM T hT hs) f)
  rw [exp_smul_one_apply]
  exact smul_nonneg_Lp (Real.exp_pos _).le (hexpJ hf)

/-- If the resolvent fixes one, its Yosida approximation kills one. -/
theorem yosida_one (hT : T.IsClosed) {s : ℝ} (hs : 0 < s)
    (hone : L2.const μ 1 ∈ T.domain) (hTone : T ⟨L2.const μ 1, hone⟩ = 0) :
    yosida T hT hs (L2.const μ 1) = 0 := by
  rw [yosida_apply, resolventCLM_one hT hs hone hTone, sub_self, smul_zero]

/-- Every Yosida exponential fixes one. -/
theorem exp_neg_smul_yosida_one (hT : T.IsClosed) {s : ℝ} (hs : 0 < s) (t : ℝ)
    (hone : L2.const μ 1 ∈ T.domain) (hTone : T ⟨L2.const μ 1, hone⟩ = 0) :
    NormedSpace.exp (-t • yosida T hT hs) (L2.const μ 1) = L2.const μ 1 := by
  apply exp_apply_of_apply_eq_zero
  change -t • yosida T hT hs (L2.const μ 1) = 0
  rw [yosida_one hT hs hone hTone, smul_zero]

/-- The Yosida exponential is sub-Markov. -/
theorem exp_neg_smul_yosida_le_one (hT : T.IsClosed)
    (hM : Energy.Markovian (μ : Measure α) (Energy.PreEnergy.normSqEnergy T))
    {s t : ℝ} (hs : 0 < s) (ht : 0 ≤ t)
    (hone : L2.const μ 1 ∈ T.domain) (hTone : T ⟨L2.const μ 1, hone⟩ = 0)
    {f : Lp ℝ 2 (μ : Measure α)} (hf : f ≤ L2.const μ 1) :
    NormedSpace.exp (-t • yosida T hT hs) f ≤ L2.const μ 1 := by
  have hpos := isPositive_exp_neg_smul_yosida hT hM hs ht
  have hdiff : 0 ≤ L2.const μ 1 - f := sub_nonneg.mpr hf
  have himage := hpos hdiff
  rw [map_sub, exp_neg_smul_yosida_one hT hs t hone hTone, sub_nonneg] at himage
  exact himage

/-! ## Passage to the generated semigroup -/

/-- The generated semigroup preserves positivity. Closedness of the `L²` positive cone transfers
the property from the Yosida exponentials to their strong limit. -/
theorem semigroupApply_positive (hT : T.IsClosed) (hd : Dense (T.domain : Set (Lp ℝ 2
    (μ : Measure α))))
    (hM : Energy.Markovian (μ : Measure α) (Energy.PreEnergy.normSqEnergy T))
    {t : ℝ} (ht : 0 ≤ t) {f : Lp ℝ 2 (μ : Measure α)} (hf : 0 ≤ f) :
    0 ≤ semigroupApply T hT hd t f := by
  apply (isClosed_Ici : IsClosed (Set.Ici (0 : Lp ℝ 2 (μ : Measure α)))).closure_subset
  refine Metric.mem_closure_iff.mpr fun ε hε ↦ ?_
  obtain ⟨δ, hδ, happ⟩ := semigroupApply_spec T hT hd ht f hε
  have hs : 0 < δ / 2 := half_pos hδ
  have hsδ : δ / 2 < δ := half_lt_self hδ
  refine ⟨NormedSpace.exp (-t • yosida T hT hs) f,
    isPositive_exp_neg_smul_yosida hT hM hs ht hf, ?_⟩
  simpa only [dist_eq_norm, norm_sub_rev] using happ hs hsδ

/-- If the form kills one, the generated semigroup fixes one. -/
theorem semigroupApply_one (hT : T.IsClosed) (hd : Dense (T.domain : Set (Lp ℝ 2
    (μ : Measure α)))) {t : ℝ} (ht : 0 ≤ t)
    (hone : L2.const μ 1 ∈ T.domain) (hTone : T ⟨L2.const μ 1, hone⟩ = 0) :
    semigroupApply T hT hd t (L2.const μ 1) = L2.const μ 1 := by
  refine (eq_semigroupApply_of_tendsto T hT hd ht (L2.const μ 1) (L2.const μ 1) ?_).symm
  intro ε hε
  refine ⟨1, one_pos, ?_⟩
  intro s hs _
  rw [exp_neg_smul_yosida_one hT hs t hone hTone, sub_self, norm_zero]
  exact hε

/-- The generated semigroup is order preserving. -/
theorem semigroupApply_mono (hT : T.IsClosed) (hd : Dense (T.domain : Set (Lp ℝ 2
    (μ : Measure α))))
    (hM : Energy.Markovian (μ : Measure α) (Energy.PreEnergy.normSqEnergy T))
    {t : ℝ} (ht : 0 ≤ t) {f g : Lp ℝ 2 (μ : Measure α)} (hfg : f ≤ g) :
    semigroupApply T hT hd t f ≤ semigroupApply T hT hd t g := by
  have hnonneg : 0 ≤ g - f := sub_nonneg.mpr hfg
  have himage := semigroupApply_positive hT hd hM ht hnonneg
  rw [semigroupApply_sub T hT hd ht, sub_nonneg] at himage
  exact himage

/-- The generated semigroup is sub-Markov. -/
theorem semigroupApply_le_one (hT : T.IsClosed) (hd : Dense (T.domain : Set (Lp ℝ 2
    (μ : Measure α))))
    (hM : Energy.Markovian (μ : Measure α) (Energy.PreEnergy.normSqEnergy T))
    {t : ℝ} (ht : 0 ≤ t)
    (hone : L2.const μ 1 ∈ T.domain) (hTone : T ⟨L2.const μ 1, hone⟩ = 0)
    {f : Lp ℝ 2 (μ : Measure α)} (hf : f ≤ L2.const μ 1) :
    semigroupApply T hT hd t f ≤ L2.const μ 1 := by
  calc
    semigroupApply T hT hd t f ≤ semigroupApply T hT hd t (L2.const μ 1) :=
      semigroupApply_mono hT hd hM ht hf
    _ = L2.const μ 1 := semigroupApply_one hT hd ht hone hTone

/-- Combined sub-Markov statement: `0 ≤ f ≤ 1` implies `0 ≤ P_t f ≤ 1`. -/
theorem semigroupApply_subMarkov (hT : T.IsClosed) (hd : Dense (T.domain : Set (Lp ℝ 2
    (μ : Measure α))))
    (hM : Energy.Markovian (μ : Measure α) (Energy.PreEnergy.normSqEnergy T))
    {t : ℝ} (ht : 0 ≤ t)
    (hone : L2.const μ 1 ∈ T.domain) (hTone : T ⟨L2.const μ 1, hone⟩ = 0)
    {f : Lp ℝ 2 (μ : Measure α)} (hf0 : 0 ≤ f) (hf1 : f ≤ L2.const μ 1) :
    0 ≤ semigroupApply T hT hd t f ∧ semigroupApply T hT hd t f ≤ L2.const μ 1 :=
  ⟨semigroupApply_positive hT hd hM ht hf0,
    semigroupApply_le_one hT hd hM ht hone hTone hf1⟩

/-! ## Consequences -/

/-- Symmetry and preservation of one imply preservation of the `L²` mean. -/
theorem mean_semigroupApply (hT : T.IsClosed) (hd : Dense (T.domain : Set (Lp ℝ 2
    (μ : Measure α)))) {t : ℝ} (ht : 0 ≤ t)
    (hone : L2.const μ 1 ∈ T.domain) (hTone : T ⟨L2.const μ 1, hone⟩ = 0)
    (f : Lp ℝ 2 (μ : Measure α)) :
    L2.mean μ (semigroupApply T hT hd t f) = L2.mean μ f := by
  rw [L2.mean, inner_semigroupApply_left T hT hd ht,
    semigroupApply_one hT hd ht hone hTone]
  rfl

/-- A positive linear semigroup satisfies `|P_t f| ≤ P_t |f|`. -/
theorem abs_semigroupApply_le (hT : T.IsClosed) (hd : Dense (T.domain : Set (Lp ℝ 2
    (μ : Measure α))))
    (hM : Energy.Markovian (μ : Measure α) (Energy.PreEnergy.normSqEnergy T))
    {t : ℝ} (ht : 0 ≤ t) (f : Lp ℝ 2 (μ : Measure α)) :
    |semigroupApply T hT hd t f| ≤ semigroupApply T hT hd t |f| := by
  rw [abs_le']
  constructor
  · exact semigroupApply_mono hT hd hM ht (le_abs_self f)
  · have h := semigroupApply_mono hT hd hM ht (neg_le_abs f)
    have hneg : -f = (-1 : ℝ) • f := by module
    rw [hneg, semigroupApply_smul T hT hd ht, neg_one_smul] at h
    exact h

/-- The generated semigroup preserves every symmetric essential bound. This is the `L^∞`
contraction stated entirely in the order of `L²`, without choosing representatives. -/
theorem abs_semigroupApply_le_const (hT : T.IsClosed) (hd : Dense (T.domain : Set (Lp ℝ 2
    (μ : Measure α))))
    (hM : Energy.Markovian (μ : Measure α) (Energy.PreEnergy.normSqEnergy T))
    {t : ℝ} (ht : 0 ≤ t)
    (hone : L2.const μ 1 ∈ T.domain) (hTone : T ⟨L2.const μ 1, hone⟩ = 0)
    (f : Lp ℝ 2 (μ : Measure α)) {C : ℝ} (_hC : 0 ≤ C)
    (hf : |f| ≤ C • L2.const μ 1) :
    |semigroupApply T hT hd t f| ≤ C • L2.const μ 1 := by
  calc
    |semigroupApply T hT hd t f| ≤ semigroupApply T hT hd t |f| :=
      abs_semigroupApply_le hT hd hM ht f
    _ ≤ semigroupApply T hT hd t (C • L2.const μ 1) :=
      semigroupApply_mono hT hd hM ht hf
    _ = C • L2.const μ 1 := by
      rw [semigroupApply_smul T hT hd ht, semigroupApply_one hT hd ht hone hTone]

end LpMarkov

end FunctionalInequalities.Analysis.Semigroup
