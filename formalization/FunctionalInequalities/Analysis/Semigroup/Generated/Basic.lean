import FunctionalInequalities.Analysis.Semigroup.Yosida.Limit

/-!
# The semigroup generated by `T†T`: naming the limit

Definitions only. `S6` (`Analysis/Semigroup/Yosida/Limit.lean`, `exists_limit_exp_neg_smul_yosida`)
gives, for `T` closed and densely defined, every `t ≥ 0` and every `f`, *some* limit of
`exp (-t • L_s) f` as `s ↓ 0`, where `L_s = yosida T hT hs` is the Yosida approximation of `T†T`.
This module names that limit: `semigroupApply T hT hd t f` is the chosen limit for `t ≥ 0` and `f`
itself for `t < 0`. Formally it is `P_t f = exp (-t T†T) f`.

Everything about `P_t` beyond its defining convergence — linearity, contraction, symmetry, the
semigroup law `P_{t+u} = P_t P_u`, strong continuity (`S7`) and the generator identity
`(P_t f - f)/t → -T†T f` on `D(T†T)` (`S8`) — is an obligation of
`research/audits/GeneratedSemigroupRouteStatements.lean`, **not** proved here. Nothing here is the
Markov property, Bakry–Émery calculus, a heat estimate or any step of Buser's inequality.
-/

noncomputable section

namespace FunctionalInequalities.Analysis.Semigroup

variable {H₀ H₁ : Type*} [NormedAddCommGroup H₀] [InnerProductSpace ℝ H₀] [CompleteSpace H₀]
  [NormedAddCommGroup H₁] [InnerProductSpace ℝ H₁] [CompleteSpace H₁]

/-- `P_t f`: the strong limit of `exp (-t • L_s) f` as `s ↓ 0` for `t ≥ 0` (chosen from `S6`), and
`f` for `t < 0`. Formally `exp (-t T†T) f`. -/
def semigroupApply (T : H₀ →ₗ.[ℝ] H₁) (hT : T.IsClosed) (hd : Dense (T.domain : Set H₀))
    (t : ℝ) (f : H₀) : H₀ :=
  if ht : 0 ≤ t then Classical.choose (exists_limit_exp_neg_smul_yosida T hT hd f ht) else f

/-- The defining property of `P_t f` for `t ≥ 0`: `exp (-t • L_s) f → P_t f` as `s ↓ 0`. -/
theorem semigroupApply_spec (T : H₀ →ₗ.[ℝ] H₁) (hT : T.IsClosed) (hd : Dense (T.domain : Set H₀))
    {t : ℝ} (ht : 0 ≤ t) (f : H₀) {ε : ℝ} (hε : 0 < ε) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ {s : ℝ} (hs : 0 < s), s < δ →
      ‖NormedSpace.exp (-t • yosida T hT hs) f - semigroupApply T hT hd t f‖ < ε := by
  unfold semigroupApply
  rw [dif_pos ht]
  exact Classical.choose_spec (exists_limit_exp_neg_smul_yosida T hT hd f ht) hε

/-- For `t < 0` the definition returns `f`; this is a convention, not a semigroup value. -/
theorem semigroupApply_of_not_nonneg (T : H₀ →ₗ.[ℝ] H₁) (hT : T.IsClosed)
    (hd : Dense (T.domain : Set H₀)) {t : ℝ} (ht : ¬ 0 ≤ t) (f : H₀) :
    semigroupApply T hT hd t f = f := by
  unfold semigroupApply
  rw [dif_neg ht]

end FunctionalInequalities.Analysis.Semigroup
